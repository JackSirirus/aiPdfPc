<Window x:Class="AIPDF.Windows.Views.Settings.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:AIPDF.Windows.Views.Settings"
        Title="快捷键设置"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}">
    <!-- V4 T12：独立宿主窗口。设置页收口后可改为直接托管 ShortcutSettingsPanel（同一 VM），
         届时本窗口可保留为命令面板入口或删除。 -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="保存"
                    Width="92"
                    Height="30"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnSaveClick" />
            <Button Content="取消"
                    Width="92"
                    Height="30"
                    IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>

        <settings:ShortcutSettingsPanel x:Name="Panel" />
    </DockPanel>
</Window>
