<UserControl x:Class="AIPDF.Windows.Views.Translation.TranslationBatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:translation="clr-namespace:AIPDF.Windows.Views.Translation"
             AllowDrop="True"
             Drop="OnFileDrop"
             DragOver="OnFileDragOver">

    <!--
      v1.1 T21 批量翻译工具页（F6 / F6b）：
      拖拽区 + 多文件列表 → 复用 T13 共享配置 → 开始处理 → 逐文件进度 → 结果列表（按需打开）。
      结果绝不自动开标签（避免 20×2 标签爆炸）；部分失败可单项重试 / 重试全部失败项。
      配色全部复用应用级 Brush.* token（DynamicResource），不新增主题 token。
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Optimizer/ToolPageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- 状态徽标：随文件状态切换配色（完成成功 / 失败错误 / 进行中主色 / 跳过次要） -->
            <Style x:Key="BatchStatusBadge" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="28,24,28,36">

            <!-- 头部 -->
            <TextBlock Style="{StaticResource OptimizerPageTitle}" Text="{Binding Tool.Name}" />
            <TextBlock Style="{StaticResource OptimizerPageSubtitle}" Margin="0,4,0,0" Text="{Binding Tool.Subtitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding Tool.Note}" />

            <!-- 浮菜单「用工具处理」置顶标记（当前文档） -->
            <Border HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Padding="8,2"
                    CornerRadius="4"
                    Background="{DynamicResource Brush.AccentSoft}"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPinnedDocument}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding PinnedDocumentLabel}"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.AccentText}" />
            </Border>

            <!-- 文件 -->
            <Border Style="{StaticResource ToolCard}" Margin="0,20,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="文件" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="添加文件"
                                Command="{Binding BrowseFilesCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,10"
                               Text="把 PDF 拖到这里，或点击添加；多份文件使用同一套设置，文件之间串行处理。" />

                    <!-- 空态 -->
                    <Border Background="{DynamicResource Brush.Sidebar}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFiles}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="尚未添加文件"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Border>

                    <!-- 超过建议上限：提示分批，不阻断 -->
                    <Border Margin="0,8,0,0"
                            Padding="10,6"
                            CornerRadius="6"
                            Background="{DynamicResource Brush.ConverterWarnBackground}"
                            Visibility="{Binding ExceedsRecommendedLimit, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.ConverterWarnText}"
                                   Text="文件较多（超过 20 份）：建议分批翻译，避免单次任务耗时过长。" />
                    </Border>

                    <!-- 文件 / 结果列表（逐项状态 + 按需打开） -->
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       ToolTip="{Binding Path}" />
                                            <!-- 结果说明（成功产物 / 失败原因） -->
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding ResultText}"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                                            <!-- 成功：按需打开 mono / dual -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Padding="10,3"
                                                        Content="打开纯译文"
                                                        Visibility="{Binding HasMono, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.OpenMonoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Margin="8,0,0,0"
                                                        Padding="10,3"
                                                        Content="打开对照"
                                                        Visibility="{Binding HasDual, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.OpenDualCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <!-- 失败：单项重试 -->
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,3"
                                                    Content="重试"
                                                    Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.RetryFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource BatchStatusBadge}"
                                                       Margin="0,2,10,0"
                                                       Text="{Binding StatusText}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Padding="10,3"
                                                    VerticalAlignment="Top"
                                                    Content="移除"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 统一设置（复用 T13 共享配置面板；作用于全部文件） -->
            <Border Style="{StaticResource ToolCard}" Margin="0,0,0,14">
                <StackPanel>
                    <translation:TranslationConfigPanel DataContext="{Binding Config}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0"
                               Text="以上设置统一作用于全部文件；引擎会新建 AIPDF-日期-编号 任务目录，不覆盖源文件。" />
                </StackPanel>
            </Border>

            <!-- 输出位置 -->
            <Border Style="{StaticResource ToolCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="输出位置" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FieldTextBox}"
                                 Text="{Binding OutputDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Content="选择…"
                                Command="{Binding BrowseOutputDirCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                               Text="处理结果会写入所选文件夹下新建的「AIPDF-日期-编号」目录。" />
                </StackPanel>
            </Border>

            <!-- 执行 / 进度 / 结果汇总 -->
            <Border Style="{StaticResource ToolCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="开始处理"
                                Command="{Binding StartCommand}" />
                        <Button Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Content="取消"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- 进度消息 -->
                    <TextBlock Margin="0,12,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding ProgressMessage}"
                               Visibility="{Binding HasProgressMessage, Converter={StaticResource BoolToVis}}" />

                    <ProgressBar Height="4"
                                 Margin="0,8,0,0"
                                 Minimum="0"
                                 Maximum="1"
                                 IsIndeterminate="{Binding IsRunning}"
                                 Value="{Binding ProgressFraction, Mode=OneWay}" />

                    <!-- 状态 / 引擎错误原文 -->
                    <TextBlock Margin="0,10,0,0" Text="{Binding StatusMessage}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="LineHeight" Value="19" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 部分完成汇总（T19）：成功 / 失败 / 跳过 + 重试全部 + 打开输出目录 -->
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding SummaryText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="重试全部失败项"
                                    Command="{Binding RetryAllFailedCommand}"
                                    Visibility="{Binding HasFailedItems, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Content="打开输出目录"
                                    Command="{Binding OpenOutputDirCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
