<UserControl x:Class="AIPDF.Windows.Views.Translation.TranslationConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      v1.1 共享翻译配置面板（T13）：阅读器「整篇」Tab（T15）与批量翻译工具页（T21）复用同一 UserControl。
      DataContext = TranslationConfigViewModel（宿主自行注入：DataContext="{Binding Config}"）。
      配色全部复用应用级 Brush.* token（DynamicResource），不新增主题 token。
      布局用块级标签（上标签 / 下控件），在 320px 右栏与全屏批量页均可用，不写死宽度。
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Prompt 模板 / 引擎选择胶囊：ListBox 原生单选，选中 = AccentSoft 底 + Accent 描边 + AccentText 字 -->
        <Style x:Key="ConfigChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.FieldBackground}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 引擎二选一：本地 / 云端（默认本地） -->
        <Style x:Key="EngineToggle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.FieldBackground}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输出勾选项：单行内自动换行 -->
        <Style x:Key="ConfigCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,16,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 标题 -->
        <TextBlock Style="{StaticResource SectionTitle}" Text="整篇翻译设置" />
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                   Text="默认本地引擎；已保存的配置跨会话自动复用，密钥存于系统凭据管理器、仅经 stdin 传递。" />

        <!-- 源语言 -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,0" Text="源语言" />
        <ComboBox Margin="0,5,0,0"
                  Style="{StaticResource FieldComboBox}"
                  MinWidth="160"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding SourceLanguageOptions}"
                  SelectedItem="{Binding SourceLanguage, Mode=TwoWay}"
                  DisplayMemberPath="Label" />
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                   Text="自动检测仅用于源语言；短句 / 专名检测不可靠时建议显式指定。" />

        <!-- 目标语言 -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="目标语言" />
        <ComboBox Margin="0,5,0,0"
                  Style="{StaticResource FieldComboBox}"
                  MinWidth="160"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding TargetLanguageOptions}"
                  SelectedItem="{Binding TargetLanguage, Mode=TwoWay}"
                  DisplayMemberPath="Label" />
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                   Text="目标语言必须显式选择，不参与自动检测。" />

        <!-- Prompt 模板 -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="Prompt 模板" />
        <ListBox Margin="0,6,0,0"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding TemplateOptions}"
                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ConfigChipItem}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="12" Text="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 自定义 Prompt（仅自定义模板可见） -->
        <TextBox Margin="0,6,0,0"
                 Style="{StaticResource FieldTextBox}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="64"
                 VerticalContentAlignment="Top"
                 Text="{Binding CustomPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsCustomTemplate, Converter={StaticResource BoolToVis}}" />

        <!-- 高风险模板提示（法律 / 医学） -->
        <Border Margin="0,8,0,0"
                Padding="10,7"
                CornerRadius="6"
                Background="{DynamicResource Brush.ConverterWarnBackground}"
                Visibility="{Binding RequiresHighRiskConfirmation, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.ConverterWarnText}"
                       Text="法律 / 医学属高风险文档：开始前会弹一次确认，产物页脚强制标注「机器翻译 · 请核对」，请务必人工复核。" />
        </Border>

        <!-- 术语表 -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="术语表" />
        <TextBox Margin="0,5,0,0"
                 Style="{StaticResource FieldTextBox}"
                 Text="{Binding GlossaryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                   Text="可选 CSV（源词,目标词[,大小写敏感[,说明]]）。留空表示不使用术语表。" />

        <!-- 引擎 -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="引擎" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <RadioButton Style="{StaticResource EngineToggle}"
                         GroupName="TranslationEngine"
                         Content="本地"
                         IsChecked="{Binding IsLocalEngine, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource EngineToggle}"
                         GroupName="TranslationEngine"
                         Content="云端 LLM"
                         IsChecked="{Binding IsCloudEngine, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,6,0,0"
                   Text="本地引擎须为 loopback 端点；云端首次使用需明确同意，密钥仅经 stdin 传递。"
                   Visibility="{Binding IsCloudEngine, Converter={StaticResource BoolToVis}}" />

        <!-- 输出 -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="输出" />
        <WrapPanel Margin="0,6,0,0">
            <CheckBox Style="{StaticResource ConfigCheckBox}" Content="纯译文 mono"
                      IsChecked="{Binding GenerateMono, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource ConfigCheckBox}" Content="对照 dual"
                      IsChecked="{Binding GenerateDual, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource ConfigCheckBox}" Content="Markdown"
                      IsChecked="{Binding ExportMarkdown, Mode=TwoWay}" />
        </WrapPanel>

        <!-- 成本上限（云端适用） -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="成本上限" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
            <TextBox Width="120"
                     Style="{StaticResource FieldTextBox}"
                     Text="{Binding CostLimitTokens, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CostLimitEnabled}" />
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="token / 任务" />
            <CheckBox Margin="16,0,0,0"
                      Style="{StaticResource ConfigCheckBox}"
                      Content="不限"
                      IsChecked="{Binding IsCostLimitUnlimited, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0" Text="{Binding CostLimitSummary}" />

        <!-- 回填策略（只读） -->
        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,0" Text="回填策略" />
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,5,0,0" Text="{Binding BackfillStrategySummary}" />

        <!-- 校验错误 -->
        <TextBlock Margin="0,10,0,0"
                   Style="{StaticResource ErrorText}"
                   Text="{Binding ValidationMessage}"
                   Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</UserControl>
