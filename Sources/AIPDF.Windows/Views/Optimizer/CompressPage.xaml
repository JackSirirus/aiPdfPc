<UserControl x:Class="AIPDF.Windows.Views.Optimizer.CompressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIPDF.Windows.Views.Optimizer"
             AllowDrop="True"
             Drop="OnFileDrop"
             DragOver="OnFileDragOver">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToolPageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="28,24,28,36">

            <!-- 头部 -->
            <TextBlock Style="{StaticResource OptimizerPageTitle}" Text="{Binding Tool.Name}" />
            <TextBlock Style="{StaticResource OptimizerPageSubtitle}" Margin="0,4,0,0" Text="{Binding Tool.Subtitle}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding Tool.Note}" />

            <!-- 文件 -->
            <Border Style="{StaticResource ToolCard}" Margin="0,20,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="文件" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="添加文件"
                                Command="{Binding BrowseFilesCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,10"
                               Text="把 PDF 拖到这里，或点击添加；每次处理都会生成新的任务目录，不覆盖源文件。" />

                    <!-- 空态 -->
                    <Border Background="{StaticResource Brush.Sidebar}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFiles}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="尚未添加文件"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextTertiary}" />
                    </Border>

                    <!-- 文件列表 -->
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Brush.TextPrimary}"
                                                   ToolTip="{Binding Path}" />
                                        <Button Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,3"
                                                Content="移除"
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 压缩方式 -->
            <Border Style="{StaticResource ToolCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="压缩方式" />
                    <ComboBox Style="{StaticResource FieldComboBox}"
                              MinWidth="220"
                              HorizontalAlignment="Left"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding QualityOptions}"
                              SelectedItem="{Binding SelectedQuality, Mode=TwoWay}"
                              DisplayMemberPath="Label" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding QualityHint}" />
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,4,0,0"
                               Text="已优化过的文件可能不会继续变小；无损模式只重组结构，体积变化有限。" />
                </StackPanel>
            </Border>

            <!-- 输出位置 -->
            <Border Style="{StaticResource ToolCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="输出位置" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FieldTextBox}"
                                 Text="{Binding OutputDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Content="选择…"
                                Command="{Binding BrowseOutputDirCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0"
                               Text="处理结果会写入所选文件夹下新建的「AIPDF-日期-编号」目录。" />
                </StackPanel>
            </Border>

            <!-- 执行 / 进度 / 结果 -->
            <local:RunPanel />
        </StackPanel>
    </ScrollViewer>
</UserControl>
