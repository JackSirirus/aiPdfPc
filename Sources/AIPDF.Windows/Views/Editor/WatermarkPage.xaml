<UserControl x:Class="AIPDF.Windows.Views.Editor.WatermarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:AIPDF.Windows.Views.Editor">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="28,24,28,32">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Tool.Name}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" Text="{Binding Tool.Subtitle}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource FieldHint}" Text="{Binding Tool.Note}" />

            <TextBlock Margin="0,22,0,0" Style="{StaticResource SectionTitle}" Text="参数" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="页面范围" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="水印文字" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="图片水印" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="2" Grid.Column="2" Margin="8,10,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="浏览…"
                        Click="OnBrowseImageClick" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="位置" />
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Width="240" HorizontalAlignment="Left"
                          Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding Positions}"
                          SelectedItem="{Binding Position}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="不透明度" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Width="240" HorizontalAlignment="Left"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="字号" />
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Width="240" HorizontalAlignment="Left"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Fontsize, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldHint}" Text="文字与图片二选一：填写图片路径时优先使用图片水印。不透明度范围 0—1。" />

            <editor:EditorRunPanel Margin="0,22,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
