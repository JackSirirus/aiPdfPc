<UserControl x:Class="AIPDF.Windows.Views.Editor.EditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AIPDF.Windows.Controls"
             xmlns:editor="clr-namespace:AIPDF.Windows.Views.Editor">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="28,24,28,32">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Tool.Name}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,0" Text="{Binding Tool.Subtitle}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource FieldHint}" Text="{Binding Tool.Note}" />

            <!-- 预览框选：catalog note「在预览中框选位置」；只消费 T13 控件 -->
            <TextBlock Margin="0,22,0,0" Style="{StaticResource SectionTitle}" Text="预览框选" />
            <controls:PdfPreviewControl x:Name="Preview"
                                        MinHeight="400" Height="440"
                                        Margin="0,12,0,0"
                                        IsRegionSelectionEnabled="True" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource SecondaryButton}"
                        Content="加载预览"
                        Click="OnLoadPreviewClick" />
                <Button Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="清除框选"
                        Click="OnClearSelectionClick" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource FieldHint}"
                           Text="{Binding SelectionSummary}" />
            </StackPanel>

            <TextBlock Margin="0,20,0,0" Style="{StaticResource SectionTitle}" Text="参数" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="页面范围" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="编辑方式" />
                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Width="240" HorizontalAlignment="Left"
                          Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding Modes}"
                          SelectedItem="{Binding Mode}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="文字内容" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                         Style="{StaticResource FieldTextBox}"
                         AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         VerticalAlignment="Top"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="图片文件" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="3" Grid.Column="2" Margin="8,10,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="浏览…"
                        Click="OnBrowseImageClick" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="字号" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Width="240" HorizontalAlignment="Left"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Fontsize, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,10,0,0" Style="{StaticResource FieldLabel}" Text="颜色" />
                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Width="240" HorizontalAlignment="Left"
                         Style="{StaticResource FieldTextBox}"
                         Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock Margin="0,20,0,0" Style="{StaticResource SectionTitle}" Text="位置与大小（pt，从页面左上角起）" />
            <UniformGrid Columns="4" Margin="0,12,0,0">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="左边距 x" />
                    <TextBox Margin="0,6,0,0" Style="{StaticResource FieldTextBox}" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="上边距 y" />
                    <TextBox Margin="0,6,0,0" Style="{StaticResource FieldTextBox}" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="宽度" />
                    <TextBox Margin="0,6,0,0" Style="{StaticResource FieldTextBox}" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="高度" />
                    <TextBox Margin="0,6,0,0" Style="{StaticResource FieldTextBox}" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>

            <editor:EditorRunPanel Margin="0,22,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
