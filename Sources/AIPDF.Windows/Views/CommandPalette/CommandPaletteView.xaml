<!-- V4 T6 命令面板覆盖层：Ctrl+K 打开，↑↓ 选择 / Enter 执行 / Esc 关闭。
     复用应用级设计 token（不引用 ReaderView 的 FlyoutPanel，避免跨视图耦合）。 -->
<UserControl x:Class="AIPDF.Windows.Views.CommandPalette.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="Collapsed"
             Focusable="True">

    <Grid>
        <!-- 半透明遮罩：点击空白处关闭（用应用级 Brush.OverlayMask，随主题切换；不得硬编码色） -->
        <Border Background="{DynamicResource Brush.OverlayMask}" MouseDown="OnBackdropMouseDown" />

        <Border Width="640"
                MaxHeight="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,88,0,0"
                Background="{DynamicResource Brush.Window}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.22" ShadowDepth="3" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="QueryBox"
                         Grid.Row="0"
                         Height="34"
                         Margin="12,12,12,8"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Brush.FieldBackground}"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         BorderBrush="{DynamicResource Brush.Border}"
                         BorderThickness="1"
                         TextChanged="OnQueryTextChanged"
                         PreviewKeyDown="OnQueryPreviewKeyDown" />

                <ListBox x:Name="ResultList"
                         Grid.Row="1"
                         MaxHeight="340"
                         Margin="12,0,12,0"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnResultActivated">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           Text="{Binding Subtitle}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Margin="12,8,12,10"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           Text="↑↓ 选择 · Enter 执行 · Esc 关闭 · 支持拼音首字母（如 qwss = 全文搜索）" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
