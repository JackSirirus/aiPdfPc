<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wf="clr-namespace:AIPDF.Windows.Views.Workflow">

    <!--
      流程工具组样式与语义色扩展。
      核心中性色与 AIPDF 蓝（Brush.Window/Sidebar/Hover/Border/Text*/Accent*）沿用 MainWindow 的同名键，
      页面全部经 DynamicResource 引用（控件装入窗口后沿逻辑树上溯解析，与主窗口保持单一来源）。
      本字典只补充状态语义色（成功/危险/中性软底）——设计系统的增量扩展。
    -->
    <SolidColorBrush x:Key="Brush.Success" Color="#1F7A3D" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E4F3E9" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#B3382E" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBEAE8" />
    <SolidColorBrush x:Key="Brush.NeutralSoft" Color="#F0F0F3" />

    <wf:InverseBooleanConverter x:Key="InverseBool" />
    <wf:StringToBoolConverter x:Key="StrBool" />
    <wf:FileNameConverter x:Key="FileName" />
    <wf:NullToVisibilityConverter x:Key="NullToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- 卡片容器 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="HelpText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- 输入控件 -->
    <Style x:Key="ToolInput" TargetType="TextBox">
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolComboBox" TargetType="ComboBox">
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 按钮：主 / 次 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小图标按钮（步骤上移/下移/移除） -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 页内 Tab：镜像侧栏条目的胶囊样式 -->
    <Style x:Key="WorkflowTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="WorkflowTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Padding="14,7"
                            Margin="0,0,8,0">
                        <ContentPresenter x:Name="HeaderHost" ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 步骤序号徽标 -->
    <Style x:Key="StepBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 队列状态胶囊：颜色由 BatchItemState 数据触发 -->
    <DataTemplate x:Key="BatchStatePill">
        <Border x:Name="Pill"
                Background="{DynamicResource Brush.NeutralSoft}"
                CornerRadius="4"
                Padding="8,2">
            <TextBlock x:Name="PillText"
                       Text="{Binding StateText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Completed">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
