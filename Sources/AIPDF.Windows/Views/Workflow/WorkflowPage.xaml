<UserControl x:Class="AIPDF.Windows.Views.Workflow.WorkflowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:AIPDF.Windows.Views.Workflow"
             x:Name="Root">
    <!-- 流程工具组（catalog 工具：工作流程）。三个能力页签：流程步骤+预设 / 批量处理 / 处理记录。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkflowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{Binding Tool.Name}" Style="{StaticResource PageTitle}" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding Tool.Subtitle}"
                       Style="{StaticResource PageSubtitle}" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding Tool.Note}"
                       Style="{StaticResource HelpText}" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource WorkflowTabControl}">

            <!-- ============ 页签 1：流程步骤 + 预设 ============ -->
            <TabItem Header="流程步骤" Style="{StaticResource WorkflowTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                            <!-- 文件 -->
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="处理文件（按顺序进入流程）"
                                                   Style="{StaticResource SectionTitle}"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Content="添加文件"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,0"
                                                Click="OnAddWorkflowFiles" />
                                        <Button Grid.Column="2"
                                                Content="清空"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding StepsVm.ClearFilesCommand}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="尚未添加文件。点击“添加文件”选择要处理的 PDF。">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StepsVm.Files.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding StepsVm.Files}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.NeutralSoft}"
                                                        CornerRadius="4"
                                                        Padding="9,3"
                                                        Margin="0,2,6,2"
                                                        ToolTip="{Binding}">
                                                    <TextBlock Text="{Binding Converter={StaticResource FileName}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- 处理步骤 -->
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="处理步骤"
                                                       Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="按顺序串联执行，每一步的输出作为下一步输入；最多 20 步。"
                                                       Style="{StaticResource HelpText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="添加步骤"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding StepsVm.AddStepCommand}" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="尚未添加步骤。点击“添加步骤”开始构建流程。">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StepsVm.Steps.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding StepsVm.Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.Sidebar}"
                                                        CornerRadius="8"
                                                        Padding="10,10"
                                                        Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource StepBadge}" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding Header}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Brush.AccentText}" />
                                                            </Border>
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding AllowedOperations}"
                                                                      SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                                                                      DisplayMemberPath="Name"
                                                                      Style="{StaticResource ToolComboBox}"
                                                                      VerticalAlignment="Center" />
                                                            <Button Grid.Column="2"
                                                                    Content="↑"
                                                                    Style="{StaticResource IconButton}"
                                                                    Margin="8,0,0,0"
                                                                    ToolTip="上移"
                                                                    Command="{Binding DataContext.StepsVm.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType={x:Type wf:WorkflowPage}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="3"
                                                                    Content="↓"
                                                                    Style="{StaticResource IconButton}"
                                                                    Margin="4,0,0,0"
                                                                    ToolTip="下移"
                                                                    Command="{Binding DataContext.StepsVm.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType={x:Type wf:WorkflowPage}}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Grid.Column="4"
                                                                    Content="移除"
                                                                    Style="{StaticResource IconButton}"
                                                                    Margin="4,0,0,0"
                                                                    ToolTip="移除该步骤"
                                                                    Command="{Binding DataContext.StepsVm.RemoveStepCommand, RelativeSource={RelativeSource AncestorType={x:Type wf:WorkflowPage}}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                        <wf:OptionsEditor Grid.Row="1"
                                                                          Margin="18,8,0,0"
                                                                          Options="{Binding Options}"
                                                                          Visibility="{Binding SelectedOperation, Converter={StaticResource NullToVis}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- 预设 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="预设" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="预设保存到本机用户目录（%APPDATA%\AIPDF\presets），只记录步骤与参数，不包含密码字段。"
                                               Style="{StaticResource HelpText}"
                                               Margin="0,2,0,10" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding StepsVm.PresetName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 Style="{StaticResource ToolInput}" />
                                        <Button Grid.Column="1"
                                                Content="保存预设"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding StepsVm.SavePresetCommand}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding StepsVm.AvailablePresets}"
                                                  SelectedItem="{Binding StepsVm.SelectedPreset, Mode=TwoWay}"
                                                  Style="{StaticResource ToolComboBox}" />
                                        <Button Grid.Column="1"
                                                Content="加载"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding StepsVm.LoadPresetCommand}" />
                                        <Button Grid.Column="2"
                                                Content="删除"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                Command="{Binding StepsVm.DeletePresetCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 输出与密码 -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="输出与密码" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="每次执行都会在输出文件夹内新建独立的任务子目录，不覆盖源文件。"
                                               Style="{StaticResource HelpText}"
                                               Margin="0,2,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding StepsVm.OutputDir, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 Style="{StaticResource ToolInput}" />
                                        <Button Grid.Column="1"
                                                Content="浏览…"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0"
                                                Click="OnBrowseWorkflowOutput" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="文件密码"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,8,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <PasswordBox x:Name="WorkflowPasswordBox"
                                                         PasswordChanged="OnWorkflowPasswordChanged"
                                                         Padding="7,5" />
                                            <TextBlock Text="解锁或加密步骤使用；仅本次运行有效，不会保存到预设。"
                                                       Style="{StaticResource HelpText}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作栏 -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.Sidebar}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="6"
                            Padding="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="开始处理"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding StepsVm.IsRunning, Converter={StaticResource InverseBool}}"
                                    Click="OnExecuteWorkflow" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding StepsVm.IsRunning}"
                                    Click="OnCancelWorkflow" />
                            <ProgressBar Grid.Column="2"
                                         Width="140"
                                         Height="6"
                                         Margin="14,0,0,0"
                                         VerticalAlignment="Center"
                                         IsIndeterminate="True"
                                         Visibility="{Binding StepsVm.IsRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Column="3"
                                       Margin="14,0,0,0"
                                       Text="{Binding StepsVm.StatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ 页签 2：批量处理 ============ -->
            <TabItem Header="批量处理" Style="{StaticResource WorkflowTabItem}">
                <wf:BatchView DataContext="{Binding BatchVm}" />
            </TabItem>

            <!-- ============ 页签 3：处理记录 ============ -->
            <TabItem Header="处理记录" Style="{StaticResource WorkflowTabItem}">
                <wf:HistoryView DataContext="{Binding HistoryVm}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
