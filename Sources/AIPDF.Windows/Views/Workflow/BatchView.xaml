<UserControl x:Class="AIPDF.Windows.Views.Workflow.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wf="clr-namespace:AIPDF.Windows.Views.Workflow"
             x:Name="Root">
    <!-- 批量处理：文件队列 → 顺序执行 → 队列状态列表。逐项错误不中断批次；批次=顺序，从不并行。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkflowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- 批量设置 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="批量设置" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="对队列中的每一项执行所选工具；“合并 PDF”会把队列文件合并为一次处理。引擎按顺序逐项执行，单项失败不中断批次。"
                                   Style="{StaticResource HelpText}"
                                   Margin="0,2,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="工具"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,8,12,0" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Tools}"
                                      SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ToolComboBox}" />
                        </Grid>
                        <wf:OptionsEditor Options="{Binding Options}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输出文件夹"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,8,12,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Style="{StaticResource ToolInput}" />
                            <Button Grid.Column="2"
                                    Content="浏览…"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="OnBrowseBatchOutput" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 批量队列 -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="批量队列"
                                       Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="添加文件"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="OnAddBatchFiles" />
                            <Button Grid.Column="2"
                                    Content="清空队列"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearQueueCommand}" />
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Text="队列为空。选择工具后点击“添加文件”，按工具语义生成队列。">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Sidebar}"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Grid.Column="0"
                                                            ContentTemplate="{StaticResource BatchStatePill}"
                                                            Content="{Binding}"
                                                            VerticalAlignment="Top"
                                                            Margin="0,1,10,0" />
                                            <StackPanel Grid.Column="1" MinWidth="180">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Files.Count, StringFormat={}{0} 个输入文件}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Margin="12,1,0,0"
                                                       Text="{Binding ResultText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                CornerRadius="6"
                Padding="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="开始批量"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"
                        Click="OnRunBatch" />
                <Button Grid.Column="1"
                        Content="取消批次"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding IsRunning}"
                        Click="OnCancelBatch" />
                <ProgressBar Grid.Column="2"
                             Width="140"
                             Height="6"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="3"
                           Margin="14,0,0,0"
                           Text="{Binding ProgressText}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.AccentText}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Margin="10,0,0,0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
