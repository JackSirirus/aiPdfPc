<UserControl x:Class="AIPDF.Windows.Views.Workflow.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- 处理记录：会话内存历史（时间/工具/输入/输出/结果），可导出 CSV。不持久化、不上传（无遥测约定）。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WorkflowResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 结果列配色 -->
            <DataTemplate x:Key="ResultCell">
                <TextBlock Text="{Binding}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="成功">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="失败">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="处理记录" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="仅保存在本次会话内存中，不上传、不落盘；需要留存时导出为 CSV。"
                               Style="{StaticResource HelpText}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="导出 CSV"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="OnExportCsv" />
                <Button Grid.Column="2"
                        Content="清空"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Window}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8">
            <Grid>
                <TextBlock Text="本次会话还没有处理记录。执行流程或批量处理后会在这里显示。"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Records.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ListView ItemsSource="{Binding Records}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="时间" Width="132" DisplayMemberBinding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                            <GridViewColumn Header="工具" Width="130" DisplayMemberBinding="{Binding Tool}" />
                            <GridViewColumn Header="输入" Width="220" DisplayMemberBinding="{Binding Inputs}" />
                            <GridViewColumn Header="输出" Width="260" DisplayMemberBinding="{Binding Outputs}" />
                            <GridViewColumn Header="结果" Width="64" CellTemplate="{StaticResource ResultCell}" />
                            <GridViewColumn Header="详情" Width="200" DisplayMemberBinding="{Binding Detail}" />
                            <GridViewColumn Header="耗时（秒）" Width="76" DisplayMemberBinding="{Binding ElapsedSeconds}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="4,8,0,0"
                   Text="{Binding StatusText}"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
    </Grid>
</UserControl>
