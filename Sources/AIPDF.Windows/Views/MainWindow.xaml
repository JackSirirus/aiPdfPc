<Window x:Class="AIPDF.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels"
        xmlns:translation="clr-namespace:AIPDF.Windows.Views.Translation"
        xmlns:views="clr-namespace:AIPDF.Windows.Views"
        xmlns:startPage="clr-namespace:AIPDF.Windows.Views.StartPage"
        Title="AIPDF · 本地 PDF 工作台"
        Width="1080" Height="700"
        MinWidth="420" MinHeight="560"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        SizeChanged="OnWindowSizeChanged"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Ctrl+F 全文搜索入口（FR-09；T8 接管前仅事件桩）+ Ctrl+W 关闭当前标签（FR-08） -->
        <KeyBinding Gesture="Ctrl+F" Command="{x:Static views:MainWindow.FullTextSearchCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{x:Static views:MainWindow.CloseActiveTabCommand}" />
        <!-- V3 T6：Ctrl+P 打印入口（FR-30）；CanExecute 由门禁驱动，加载中/未解锁自动禁用（AC-30.2） -->
        <KeyBinding Gesture="Ctrl+P" Command="{x:Static views:MainWindow.PrintCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static views:MainWindow.FullTextSearchCommand}"
                        Executed="OnFullTextSearchExecuted" />
        <CommandBinding Command="{x:Static views:MainWindow.CloseActiveTabCommand}"
                        Executed="OnCloseActiveTabExecuted" />
        <CommandBinding Command="{x:Static views:MainWindow.PrintCommand}"
                        Executed="OnPrintExecuted"
                        CanExecute="OnPrintCanExecute" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- 色板 token 统一由应用级 App.xaml 提供（V3 T10：亮/暗两套 + ThemeManager 运行时注入）；
             此处不再复制 Brush.* 定义，所有主题引用为 DynamicResource 以支持运行时切换。 -->

        <!-- V2 T7：队列控件可见性（执行�?有排队项时显示） -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SidebarToolItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- 侧栏条目的可访问名称取自工具名（否则 UIA 通报类型名 AIPDF.Windows.Models.Tool） -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ToolItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Margin="0,1,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeaderTemplate">
            <TextBlock Text="{Binding Name}"
                       Margin="8,16,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextTertiary}" />
        </DataTemplate>

        <!-- 顶栏图标按钮：＋ 新建标签 / 搜索 / ⚙ 设置 -->
        <Style x:Key="TopBarIconButton" TargetType="Button">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签头内容：类别图标 + 文件名（ellipsis + 悬停全路径）+ ✕ 关闭（FR-07） -->
        <DataTemplate x:Key="TabHeaderTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="{Binding KindGlyph}"
                           FontSize="11"
                           Margin="0,0,6,1"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Text="{Binding Title}"
                           MaxWidth="168"
                           FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{Binding ToolTipText}"
                           TextTrimming="CharacterEllipsis" />
                <Button Click="OnCloseTabClick"
                        Margin="6,0,8,0"
                        Style="{StaticResource TabCloseButton}"
                        ToolTip="关闭标签"
                        AutomationProperties.Name="关闭标签">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- 标签头容器：激活 = 白底 + 蓝色底线（FR-07），与顶栏底边齐平 -->
        <Style x:Key="TabStripItem" TargetType="ListBoxItem">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,8,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="7,7,0,0"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Window}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏标签条（ListBox 承载标签头）：溢出横向滚动【ST-19 基础】 -->
        <Style x:Key="TabStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource TabHeaderTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabStripItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="ScrollHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏阅读面板切换器（骨架按钮组；面板内容由 T4 填充） -->
        <Style x:Key="ReaderPanelToggle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ReaderPanels" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,5">
                            <ContentPresenter x:Name="ContentHost"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <!-- A+C Phase 2：活动导航项 = 白底 + 强调文字 + 半粗（不再用 AccentSoft 填充） -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Window}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v1.1 翻译右栏双 Tab（划词 / 整篇）：强调底线标识当前 Tab（A+C 暖纸体系，无新增 token） -->
        <Style x:Key="TranslationTabToggle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="TranslationTabs" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6,6,0,0"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主区标签宿主（原 ToolPageHost ContentControl 位）：仅承载内容，头部在顶栏标签条 -->
        <Style x:Key="TabHostItem" TargetType="TabItem">
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="Content" Value="{Binding Content}" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="TabHostStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabHostItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <!-- PART_SelectedContentHost 是 TabControl 查找选中内容的模板部件名（缺失会导致选中内容不显示） -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A+C Phase 2：状态栏保存胶囊四态（FR-19 / ST-08/20/21/22）。
             已保存 = AccentSoft 底 + AccentText 文字 + Success 绿点；保存中 = ConverterWarn*；
             失败 = DangerSoft/Danger；只读 = NeutralSoft/TextSecondary。
             状态来自 SavePillViewModel.State（SavePill.DataContext 在代码后置指定）。 -->
        <Style x:Key="StatusSavePill" TargetType="Button">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="SavedDot"
                                         Width="6"
                                         Height="6"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Success}"
                                         Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 已保存：绿点表示已落盘 -->
                            <DataTrigger Binding="{Binding State}" Value="Saved">
                                <Setter TargetName="SavedDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Saving">
                    <Setter Property="Background" Value="{DynamicResource Brush.ConverterWarnBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.ConverterWarnText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ReadOnly">
                    <Setter Property="Background" Value="{DynamicResource Brush.NeutralSoft}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：品牌区 + 标签条 + ＋ 新建 + 全文搜索入口 + ⚙ 设置占位（FR-07） -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌区 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,10,0">
                        <Border Width="20" Height="20"
                                CornerRadius="6"
                                Background="{DynamicResource Brush.Accent}"
                                VerticalAlignment="Center">
                            <TextBlock Text="A"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AIPDF"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标签条（数据上下文 = TabHostViewModel，由代码后置指定） -->
                    <ListBox x:Name="TabStrip"
                             Grid.Column="1"
                             Style="{StaticResource TabStrip}"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             PreviewMouseWheel="OnTabStripMouseWheel" />

                    <!-- 动作区 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,10,0">
                        <!-- 工具箱入口：与是否有标签无关，始终可见；展开主区左对齐工具面板（T20） -->
                        <Button Style="{StaticResource TopBarIconButton}"
                                Click="OnToolboxClick"
                                ToolTip="工具箱：全部工具入口"
                                AutomationProperties.Name="工具箱">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="工具箱" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TopBarIconButton}"
                                Click="OnNewTabClick"
                                ToolTip="打开 PDF 文档（新建标签）"
                                AutomationProperties.Name="新建标签">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource TopBarIconButton}"
                                Click="OnFullTextSearchClick"
                                ToolTip="全文搜索 (Ctrl+F)"
                                AutomationProperties.Name="全文搜索">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="搜索" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- V3 T6：打印入口（Q3 裁决：Ctrl+P + 顶栏按钮，不新增菜单栏）；命令 CanExecute = 打印门禁 -->
                        <Button Style="{StaticResource TopBarIconButton}"
                                Command="{x:Static views:MainWindow.PrintCommand}"
                                ToolTip="打印当前文档 (Ctrl+P)"
                                AutomationProperties.Name="打印">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="打印" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- ⚙ 设置入口（V3 T5）：点击弹出下拉菜单「设置 | 关于·许可」（AC-38.1，无「检查更新」） -->
                        <Button Style="{StaticResource TopBarIconButton}"
                                Click="OnSettingsMenuClick"
                                ToolTip="设置与关于"
                                AutomationProperties.Name="设置">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="设置"
                                              Click="OnSettingsMenuItemClick"
                                              AutomationProperties.Name="设置" />
                                    <MenuItem Header="关于·许可"
                                              Click="OnAboutMenuItemClick"
                                              AutomationProperties.Name="关于·许可" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主区域：左栏（阅读面板）/ 右标签宿主（工具箱为顶栏入口 + 主区左对齐滑出面板） -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPanelColumn" Width="264" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <!-- v1.1 翻译右栏停靠列（Width 由代码后置按响应式模式设置：停靠 320 / 其余 0） -->
                    <ColumnDefinition x:Name="TranslationColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：阅读面板容器（T4 填充）。工具箱已移至顶栏按钮 + 主区左对齐滑出面板（T20），左栏仅保留阅读面板。 -->
                <Border x:Name="LeftPanel" Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
                    <Grid Margin="14,14,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 1: 阅读面板宿主。必须 *（有界高度）：Auto 会让缩略图 ListBox 得到无限高、
                                 一次性铺开全部项，既无法自身滚动，ScrollIntoView 联动也无效。 -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 面板切换器：缩略图/目录/书签/搜索（搜索面板 T8 已实现） -->
                        <StackPanel x:Name="ReaderPanelSwitcher" Grid.Row="0" Orientation="Horizontal" Visibility="Collapsed">
                            <RadioButton x:Name="PanelToggleThumbs" Content="缩略图" Tag="thumbs" Style="{StaticResource ReaderPanelToggle}" IsChecked="True" Checked="OnReaderPanelChecked" AutomationProperties.Name="缩略图面板" />
                            <RadioButton x:Name="PanelToggleOutline" Content="目录" Tag="outline" Style="{StaticResource ReaderPanelToggle}" Checked="OnReaderPanelChecked" AutomationProperties.Name="目录面板" />
                            <RadioButton x:Name="PanelToggleBookmarks" Content="书签" Tag="bookmarks" Style="{StaticResource ReaderPanelToggle}" Checked="OnReaderPanelChecked" AutomationProperties.Name="书签面板" />
                            <RadioButton x:Name="PanelToggleSearch" Content="搜索" Tag="search" Style="{StaticResource ReaderPanelToggle}" Checked="OnReaderPanelChecked" AutomationProperties.Name="搜索面板" />
                        </StackPanel>

                        <!-- 面板内容宿主：内容由代码后置按切换填充（T4 真实面板 / T8 搜索） -->
                        <ContentControl x:Name="ReaderPanelHost" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <GridSplitter x:Name="LeftSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- 主宿主：标签内容 / 未认领工具详情兜底 / 起始页空态 -->
                <Grid x:Name="MainHost" Grid.Column="2">
                    <!-- 主区内容宿主：直接承载当前选中标签的 Content（阅读视图 / 工具页）。
                         原先用 TabControl，但其自定义模板缺少 items host（TabPanel/ItemsPresenter），
                         导致 TabItem 容器不生成、TabControl.SelectedContent 恒为 null，选中内容从不渲染
                         （大文档主区白屏的根因）。标签头由顶栏 ListBox 承载，主区只需显示选中内容，故用 ContentControl。 -->
                    <ContentControl x:Name="TabHostControl"
                                    Content="{Binding SelectedTab.Content}"
                                    Visibility="Collapsed" />

                    <!-- 详情区兜底：未被注册表认领的工具显示占位视图（保留原工具入口形态） -->
                    <Grid x:Name="DetailPlaceholder" Visibility="Collapsed">
                        <!-- 空态 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    TextBlock.TextAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTool}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="72" Height="72"
                                    CornerRadius="18"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="A"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,20,0,0"
                                       Text="从顶部「工具箱」选择工具开始"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="选择工具后添加文件、调整参数即可处理。所有操作都在本机完成，文档不会上传。"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 选中态：详情占位 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="520">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTool}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="{Binding SelectedTool.Category}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.AccentText}" />
                            </Border>
                            <TextBlock Margin="0,14,0,0"
                                       Text="{Binding SelectedTool.Name}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SelectedTool.Subtitle}"
                                       FontSize="14"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="{Binding SelectedTool.Note}"
                                       FontSize="12"
                                       LineHeight="20"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,24,0,0"
                                    Content="开始处理"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Padding="18,7"
                                    FontSize="13"
                                    Foreground="{DynamicResource Brush.OnAccent}"
                                    Background="{DynamicResource Brush.Accent}"
                                    BorderThickness="0" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="工具操作界面将在后续版本中提供。"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                        </StackPanel>
                    </Grid>

                    <!-- 空态：零标签 → 起始页（T6：打开按钮 / 最近文件 / 常用工具 / 全部工具入口，FR-33/34/35） -->
                    <startPage:StartPageView x:Name="StartPage" Visibility="Collapsed" />

                    <!-- 工具箱滑出面板（T20）：左对齐覆盖层，宽度 340；顶栏「工具箱」按钮展开，✕ / Esc 关闭。
                         内容与左栏原工具箱同源（ToolsView 分组视图 + 既有模板），点击工具 → ShowToolPage 并关闭面板。
                         配色与投影镜像右侧 RightDrawer。 -->
                    <Border x:Name="ToolboxPanel"
                            Width="340"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,1,0"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <!-- A+C Phase 3：页影维持 #000000。原因：(1) ThemeManager 仅换 Brush 而非 Color，暖化需要 Color token（超出当前机制）；(2) 审计脚本对 #000000 阴影做了显式跳过，换成暖色会被判定为白名单外硬编码。 -->
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="0" Opacity="0.14" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 面板头：标题「工具箱」+ 关闭 ✕ -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource Brush.Sidebar}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,8,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="工具箱"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Text="{Binding Tools.Count, StringFormat={}{0} 个工具 · 全部本机处理}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TopBarIconButton}"
                                            Click="OnCloseToolboxClick"
                                            ToolTip="关闭工具箱"
                                            AutomationProperties.Name="关闭工具箱">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 分组工具列表：与左栏原工具箱同款容器/模板；选择 → ShowToolPage → 关闭面板 -->
                            <ScrollViewer Grid.Row="1" Padding="10,4,6,8" VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="ToolboxList"
                                         ItemsSource="{Binding ToolsView}"
                                         ItemContainerStyle="{StaticResource SidebarToolItem}"
                                         ItemTemplate="{StaticResource ToolItemTemplate}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0,0,2,8"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnToolboxToolSelected">
                                    <ListBox.GroupStyle>
                                        <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                                    </ListBox.GroupStyle>
                                </ListBox>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 右抽屉（T7 / 决策 7）：单文件工具（organize / pdfa）内联参数面板宿主。
                         右对齐覆盖层，宽度 380；关闭只隐藏不销毁（页面实例缓存于代码后置【D16】）。
                         抽屉内容是现有工具页实例（自设 DataContext，含文件列表 + 参数区 + 运行条），
                         不另建每工具参数 UI。 -->
                    <Border x:Name="RightDrawer"
                            Width="380"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <!-- A+C Phase 3：页影维持 #000000。原因：(1) ThemeManager 仅换 Brush 而非 Color，暖化需要 Color token（超出当前机制）；(2) 审计脚本对 #000000 阴影做了显式跳过，换成暖色会被判定为白名单外硬编码。 -->
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="180" Opacity="0.14" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 抽屉头：工具名 + 关闭 ✕ -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource Brush.Sidebar}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,8,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RightDrawerTitle"
                                               Grid.Column="0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TopBarIconButton}"
                                            Click="OnCloseRightDrawerClick"
                                            ToolTip="关闭"
                                            AutomationProperties.Name="关闭工具抽屉">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 工具页内容宿主：代码后置按工具 id 挂现有工具页实例 -->
                            <ContentControl x:Name="RightDrawerContent" Grid.Row="1" />
                        </Grid>
                    </Border>

                    <!-- ST-12：恢复上次阅读位置的一次性提示条（阅读区顶部居中，2s 自动消失，不打断阅读） -->
                    <Border x:Name="RestoreHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,12,0,0"
                            Padding="14,7"
                            CornerRadius="8"
                            Background="{DynamicResource Brush.TextPrimary}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="RestoreHintText"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.OnAccent}" />
                    </Border>
                </Grid>

                <!-- v1.1 T12 翻译右栏容器：文档标签激活时显示，宽 320（区别于 RightDrawer 的 380）。
                     布局模式由代码后置按窗口宽度切换（见 TranslationSidebarLayout）：
                       ≥680px 停靠为右侧独立列；480–680px 覆盖在阅读区右侧；<480px 折叠为浮动「翻译」开关。
                     Tab 内容为占位，T13（配置）/ T14（划词）/ T15（整篇）填充。
                     配色全部复用 A+C Brush.* token（DynamicResource），不新增 token。 -->
                <Border x:Name="TranslationSidebar"
                        Grid.Column="3"
                        Width="320"
                        Panel.ZIndex="30"
                        Background="{DynamicResource Brush.Window}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <!-- 页影维持 #000000（主题无关；审计脚本对其显式跳过），与 RightDrawer / ToolboxPanel 一致。 -->
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="180" Opacity="0.14" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 头部：双 Tab「划词 / 整篇」+ 紧凑态关闭 ✕ -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Brush.Sidebar}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <RadioButton x:Name="TranslationTabSelection"
                                                 Content="划词"
                                                 Tag="selection"
                                                 IsChecked="True"
                                                 Style="{StaticResource TranslationTabToggle}"
                                                 Checked="OnTranslationTabChecked"
                                                 AutomationProperties.Name="划词翻译" />
                                    <RadioButton x:Name="TranslationTabFull"
                                                 Content="整篇"
                                                 Tag="full"
                                                 Style="{StaticResource TranslationTabToggle}"
                                                 Checked="OnTranslationTabChecked"
                                                 AutomationProperties.Name="整篇翻译" />
                                </StackPanel>
                                <Button x:Name="TranslationCloseButton"
                                        Grid.Column="1"
                                        Style="{StaticResource TopBarIconButton}"
                                        Click="OnCloseTranslationSidebarClick"
                                        ToolTip="收起翻译栏"
                                        AutomationProperties.Name="收起翻译栏"
                                        Visibility="Collapsed">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 内容：划词（T14 卡片堆叠 + 空态 + F1b 无文本层态）/ 整篇（占位，T15 填充） -->
                        <Grid Grid.Row="1">
                            <Grid x:Name="TranslationSelectionHost">
                                <!-- 卡片堆叠：新卡置顶、上限 20（VM 保证）；DataTemplate 复用 SelectionTranslationCard -->
                                <ScrollViewer x:Name="TranslationCardsScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="14,14,14,12">
                                    <StackPanel>
                                        <ItemsControl x:Name="TranslationCardsList">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <translation:SelectionTranslationCard
                                                        Margin="0,0,0,10"
                                                        ActionRequested="OnTranslationCardActionRequested" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TranslationEmptyHint"
                                                   Text="在阅读区选中文字，选区附近会浮出「译」按钮；点击后译文显示在这里。"
                                                   Style="{StaticResource FieldHint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- F1b 无文本层态：显式禁用划词并给出替代路径，不做「框选没反应」 -->
                                <StackPanel x:Name="TranslationNoTextLayerState"
                                            Margin="14,14,14,12"
                                            Visibility="Collapsed">
                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="10"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.NeutralSoft}">
                                        <TextBlock Text="&#x25A8;"
                                                   FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </Border>
                                    <TextBlock Text="本页无文本层"
                                               Style="{StaticResource SectionTitle}"
                                               Margin="0,10,0,0" />
                                    <TextBlock Text="此页是扫描图片，没有可选文字，划词翻译不可用。可改用整篇翻译（先 OCR 该页），或先对本页 OCR。"
                                               Style="{StaticResource FieldHint}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap" />
                                    <Button x:Name="TranslationNoTextLayerFullButton"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,12,0,0"
                                            Content="用整篇翻译（先 OCR）"
                                            Click="OnNoTextLayerUseFullClick" />
                                    <Button x:Name="TranslationNoTextLayerOcrButton"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,8,0,0"
                                            Content="仅本页 OCR"
                                            Click="OnNoTextLayerOcrClick" />
                                    <TextBlock Text="无文本层页不会静默失败；划词入口显式禁用并给出替代路径。"
                                               Style="{StaticResource FieldHint}"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <!-- 整篇（T15）：配置 → 开始 → 进度 → 结果（内容/逻辑在 FullTranslationPanel + VM） -->
                            <translation:FullTranslationPanel x:Name="TranslationFullPanel" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 紧凑态开关：<480px 折叠后从右侧唤出翻译栏（覆盖模式） -->
                <Button x:Name="TranslationToggleButton"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,10,0"
                        Panel.ZIndex="31"
                        Style="{StaticResource TopBarIconButton}"
                        Click="OnToggleTranslationSidebarClick"
                        ToolTip="打开翻译"
                        AutomationProperties.Name="打开翻译"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C1;" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="翻译" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- V2 T7：执行中任务被取消时的短暂 Toast（排队项取消不触发；由代码后置 2s 自动隐藏） -->
            <Border x:Name="QueueToast"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="14,7"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.TextPrimary}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="20">
                <TextBlock x:Name="QueueToastText"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.OnAccent}" />
            </Border>

            <!-- V2 T6：会话恢复时失效文件汇总 Toast（AC-29.1；由代码后置 2s 自动隐藏） -->
            <Border x:Name="SessionToast"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,20"
                    Padding="14,7"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.TextPrimary}"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="21">
                <TextBlock x:Name="SessionToastText"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.OnAccent}" />
            </Border>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Brush.Sidebar}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" />
                        <!-- T4 savepill（FR-19 四态）：仅文档标签激活时可见；失败态可点击重试。
                             A+C Phase 2：四态视觉见 Window.Resources/StatusSavePill。 -->
                        <Button x:Name="SavePill"
                                Margin="12,0,0,0"
                                Style="{StaticResource StatusSavePill}"
                                Command="{Binding RetryCommand}"
                                ToolTip="{Binding ErrorDetail}"
                                AutomationProperties.Name="{Binding Text}">
                            <TextBlock Text="{Binding Text}" />
                        </Button>

                        <!-- V3 T6：打印进度 + 取消（FR-30 状态转录；进度经 UI 线程回封送，F3-BLK-1） -->
                        <StackPanel x:Name="PrintProgressPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.AccentText}"
                                       VerticalAlignment="Center" />
                            <Button Margin="6,0,0,0"
                                    Padding="8,1"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Click="OnCancelPrintClick"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="取消打印准备"
                                    AutomationProperties.Name="取消打印">
                                <TextBlock Text="取消" />
                            </Button>
                        </StackPanel>

                        <!-- V2 T7：全局任务队列状态（独立控件，不覆盖 StatusText 消息）；✕ 取消单个排队项（FR-41） -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Queue.HasRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="12,0,0,0"
                                       Text="{Binding Queue.StatusText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.AccentText}"
                                       VerticalAlignment="Center" />
                            <ItemsControl Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding Queue.Pending}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,0,0,0"
                                                Padding="6,1"
                                                CornerRadius="4"
                                                Background="{DynamicResource Brush.AccentSoft}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding PositionText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.AccentText}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Margin="4,0,0,0"
                                                           Text="{Binding Name}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.AccentText}"
                                                           VerticalAlignment="Center" />
                                                <Button Margin="4,0,0,0"
                                                        Padding="2,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="取消该排队任务"
                                                        AutomationProperties.Name="取消排队任务"
                                                        Command="{Binding DataContext.Queue.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="8" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="AIPDF for Windows · v0.1.0"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
