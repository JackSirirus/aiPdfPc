<Window x:Class="AIPDF.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels"
        xmlns:views="clr-namespace:AIPDF.Windows.Views"
        xmlns:startPage="clr-namespace:AIPDF.Windows.Views.StartPage"
        Title="AIPDF · 本地 PDF 工作台"
        Width="1080" Height="700"
        MinWidth="860" MinHeight="560"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <!-- Ctrl+F 全文搜索入口（FR-09；T8 接管前仅事件桩）+ Ctrl+W 关闭当前标签（FR-08） -->
        <KeyBinding Gesture="Ctrl+F" Command="{x:Static views:MainWindow.FullTextSearchCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{x:Static views:MainWindow.CloseActiveTabCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static views:MainWindow.FullTextSearchCommand}"
                        Executed="OnFullTextSearchExecuted" />
        <CommandBinding Command="{x:Static views:MainWindow.CloseActiveTabCommand}"
                        Executed="OnCloseActiveTabExecuted" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- 色板：中性灰系 + AIPDF 蓝（#3159D9，与引擎默认编辑色一致） -->
        <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.Sidebar" Color="#F6F6F8" />
        <SolidColorBrush x:Key="Brush.Hover" Color="#EBEBEF" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E4E4E9" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#3159D9" />
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4EAFB" />
        <SolidColorBrush x:Key="Brush.AccentText" Color="#2A4CBB" />

        <Style x:Key="SidebarToolItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- 侧栏条目的可访问名称取自工具名（否则 UIA 通报类型名 AIPDF.Windows.Models.Tool） -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ToolItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Margin="0,1,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeaderTemplate">
            <TextBlock Text="{Binding Name}"
                       Margin="8,16,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextTertiary}" />
        </DataTemplate>

        <!-- 顶栏图标按钮：＋ 新建标签 / 搜索 / ⚙ 设置 -->
        <Style x:Key="TopBarIconButton" TargetType="Button">
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签头内容：类别图标 + 文件名（ellipsis + 悬停全路径）+ ✕ 关闭（FR-07） -->
        <DataTemplate x:Key="TabHeaderTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="{Binding KindGlyph}"
                           FontSize="11"
                           Margin="0,0,6,1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}" />
                <TextBlock Text="{Binding Title}"
                           MaxWidth="168"
                           FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{Binding ToolTipText}"
                           TextTrimming="CharacterEllipsis" />
                <Button Click="OnCloseTabClick"
                        Margin="6,0,8,0"
                        Style="{StaticResource TabCloseButton}"
                        ToolTip="关闭标签"
                        AutomationProperties.Name="关闭标签">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- 标签头容器：激活 = 白底 + 蓝色底线（FR-07），与顶栏底边齐平 -->
        <Style x:Key="TabStripItem" TargetType="ListBoxItem">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,8,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="7,7,0,0"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Window}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏标签条（ListBox 承载标签头）：溢出横向滚动【ST-19 基础】 -->
        <Style x:Key="TabStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemTemplate" Value="{StaticResource TabHeaderTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabStripItem}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="ScrollHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏阅读面板切换器（骨架按钮组；面板内容由 T4 填充） -->
        <Style x:Key="ReaderPanelToggle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="ReaderPanels" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,5">
                            <ContentPresenter x:Name="ContentHost"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主区标签宿主（原 ToolPageHost ContentControl 位）：仅承载内容，头部在顶栏标签条 -->
        <Style x:Key="TabHostItem" TargetType="TabItem">
            <Setter Property="Header" Value="{Binding Title}" />
            <Setter Property="Content" Value="{Binding Content}" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <Style x:Key="TabHostStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Brush.Window}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TabHostItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Brush.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏：品牌区 + 标签条 + ＋ 新建 + 全文搜索入口 + ⚙ 设置占位（FR-07） -->
            <Border Grid.Row="0"
                    Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌区 -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,10,0">
                        <Border Width="20" Height="20"
                                CornerRadius="6"
                                Background="{StaticResource Brush.Accent}"
                                VerticalAlignment="Center">
                            <TextBlock Text="A"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AIPDF"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标签条（数据上下文 = TabHostViewModel，由代码后置指定） -->
                    <ListBox x:Name="TabStrip"
                             Grid.Column="1"
                             Style="{StaticResource TabStrip}"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             PreviewMouseWheel="OnTabStripMouseWheel" />

                    <!-- 动作区 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="6,0,10,0">
                        <Button Style="{StaticResource TopBarIconButton}"
                                Click="OnNewTabClick"
                                ToolTip="打开 PDF 文档（新建标签）"
                                AutomationProperties.Name="新建标签">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource TopBarIconButton}"
                                Click="OnFullTextSearchClick"
                                ToolTip="全文搜索 (Ctrl+F)"
                                AutomationProperties.Name="全文搜索">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="搜索" FontSize="12" Margin="6,0,2,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <!-- ⚙ 设置占位：V3 实现设置面板（FR-38），当前禁用 -->
                        <Button Style="{StaticResource TopBarIconButton}"
                                IsEnabled="False"
                                ToolTip="设置（后续版本提供）"
                                AutomationProperties.Name="设置">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主区域：左栏（阅读面板骨架 + 工具箱）/ 右标签宿主 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPanelColumn" Width="264" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：阅读面板容器骨架（T4 填充）+ 工具箱（现有工具入口，保持可用） -->
                <Border x:Name="LeftPanel" Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
                    <Grid Margin="14,14,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 面板切换器：缩略图/目录/书签/搜索（搜索面板本体 T8 填充，当前占位） -->
                        <StackPanel x:Name="ReaderPanelSwitcher" Grid.Row="0" Orientation="Horizontal" Visibility="Collapsed">
                            <RadioButton Content="缩略图" Tag="thumbs" Style="{StaticResource ReaderPanelToggle}" IsChecked="True" Checked="OnReaderPanelChecked" />
                            <RadioButton Content="目录" Tag="outline" Style="{StaticResource ReaderPanelToggle}" Checked="OnReaderPanelChecked" />
                            <RadioButton Content="书签" Tag="bookmarks" Style="{StaticResource ReaderPanelToggle}" Checked="OnReaderPanelChecked" />
                            <RadioButton Content="搜索" Tag="search" Style="{StaticResource ReaderPanelToggle}" Checked="OnReaderPanelChecked" />
                        </StackPanel>

                        <!-- 面板内容宿主：内容由代码后置按切换填充（T4 真实面板 / T8 搜索） -->
                        <ContentControl x:Name="ReaderPanelHost" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,16,0,0"
                                   Text="工具箱"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,4,0,8"
                                   Text="{Binding Tools.Count, StringFormat={}{0} 个工具 · 全部本机处理}"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" />

                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding ToolsView}"
                                     SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource SidebarToolItem}"
                                     ItemTemplate="{StaticResource ToolItemTemplate}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,0,2,8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                                </ListBox.GroupStyle>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter x:Name="LeftSplitter"
                              Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- 主宿主：标签内容 / 未认领工具详情兜底 / 起始页空态 -->
                <Grid x:Name="MainHost" Grid.Column="2">
                    <!-- 标签宿主（原 xaml:241 ContentControl 位）：TabItem 内容 = 阅读占位 / 工具页（数据上下文 = TabHostViewModel） -->
                    <TabControl x:Name="TabHostControl"
                                Style="{StaticResource TabHostStyle}"
                                ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                Visibility="Collapsed" />

                    <!-- 详情区兜底：未被注册表认领的工具显示占位视图（保留原工具入口形态） -->
                    <Grid x:Name="DetailPlaceholder" Visibility="Collapsed">
                        <!-- 空态 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="420"
                                    TextBlock.TextAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTool}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="72" Height="72"
                                    CornerRadius="18"
                                    Background="{StaticResource Brush.AccentSoft}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="A"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,20,0,0"
                                       Text="从左侧选择一个工具开始"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="选择工具后添加文件、调整参数即可处理。所有操作都在本机完成，文档不会上传。"
                                       FontSize="13"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 选中态：详情占位 -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="520">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTool}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border HorizontalAlignment="Left"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Background="{StaticResource Brush.AccentSoft}">
                                <TextBlock Text="{Binding SelectedTool.Category}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.AccentText}" />
                            </Border>
                            <TextBlock Margin="0,14,0,0"
                                       Text="{Binding SelectedTool.Name}"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SelectedTool.Subtitle}"
                                       FontSize="14"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="{Binding SelectedTool.Note}"
                                       FontSize="12"
                                       LineHeight="20"
                                       Foreground="{StaticResource Brush.TextTertiary}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,24,0,0"
                                    Content="开始处理"
                                    IsEnabled="False"
                                    HorizontalAlignment="Left"
                                    Padding="18,7"
                                    FontSize="13"
                                    Foreground="White"
                                    Background="{StaticResource Brush.Accent}"
                                    BorderThickness="0" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="工具操作界面将在后续版本中提供。"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.TextTertiary}" />
                        </StackPanel>
                    </Grid>

                    <!-- 空态：零标签 → 起始页（T6：打开按钮 / 最近文件 / 常用工具 / 全部工具入口，FR-33/34/35） -->
                    <startPage:StartPageView x:Name="StartPage" Visibility="Collapsed" />

                    <!-- 右抽屉（T7 / 决策 7）：单文件工具（organize / pdfa）内联参数面板宿主。
                         右对齐覆盖层，宽度 380；关闭只隐藏不销毁（页面实例缓存于代码后置【D16】）。
                         抽屉内容是现有工具页实例（自设 DataContext，含文件列表 + 参数区 + 运行条），
                         不另建每工具参数 UI。 -->
                    <Border x:Name="RightDrawer"
                            Width="380"
                            HorizontalAlignment="Right"
                            Background="{StaticResource Brush.Window}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="180" Opacity="0.14" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 抽屉头：工具名 + 关闭 ✕ -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource Brush.Sidebar}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,8,8,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RightDrawerTitle"
                                               Grid.Column="0"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TopBarIconButton}"
                                            Click="OnCloseRightDrawerClick"
                                            ToolTip="关闭"
                                            AutomationProperties.Name="关闭工具抽屉">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 工具页内容宿主：代码后置按工具 id 挂现有工具页实例 -->
                            <ContentControl x:Name="RightDrawerContent" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="AIPDF for Windows · v0.1.0"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextTertiary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
