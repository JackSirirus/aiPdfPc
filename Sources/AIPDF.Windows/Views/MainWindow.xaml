<Window x:Class="AIPDF.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels"
        Title="AIPDF · 本地 PDF 工作台"
        Width="1080" Height="700"
        MinWidth="860" MinHeight="560"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- 色板：中性灰系 + AIPDF 蓝（#3159D9，与引擎默认编辑色一致） -->
        <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.Sidebar" Color="#F6F6F8" />
        <SolidColorBrush x:Key="Brush.Hover" Color="#EBEBEF" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E4E4E9" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#3159D9" />
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4EAFB" />
        <SolidColorBrush x:Key="Brush.AccentText" Color="#2A4CBB" />

        <Style x:Key="SidebarToolItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ToolItemTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Margin="0,1,0,0"
                           Text="{Binding Subtitle}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupHeaderTemplate">
            <TextBlock Text="{Binding Name}"
                       Margin="8,16,0,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextTertiary}" />
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Brush.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 主区域：左工具目录 / 右工具详情占位 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="264" MinWidth="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧栏：工具目录（数据来自 backend/catalog.json） -->
                <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
                    <Grid Margin="14,18,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="工具箱"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,8"
                                   Text="{Binding Tools.Count, StringFormat={}{0} 个工具 · 全部本机处理}"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding ToolsView}"
                                     SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource SidebarToolItem}"
                                     ItemTemplate="{StaticResource ToolItemTemplate}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,0,2,8"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.GroupStyle>
                                    <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                                </ListBox.GroupStyle>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent" />

                <!-- 详情占位：未选中显示空态，选中显示工具信息（具体工具页属 Wave 5） -->
                <Grid Grid.Column="2">
                    <!-- 空态 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                TextBlock.TextAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTool}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="72" Height="72"
                                CornerRadius="18"
                                Background="{StaticResource Brush.AccentSoft}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="A"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="0,20,0,0"
                                   Text="从左侧选择一个工具开始"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="选择工具后添加文件、调整参数即可处理。所有操作都在本机完成，文档不会上传。"
                                   FontSize="13"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 选中态：详情占位 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="520">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTool}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border HorizontalAlignment="Left"
                                CornerRadius="10"
                                Padding="8,3"
                                Background="{StaticResource Brush.AccentSoft}">
                            <TextBlock Text="{Binding SelectedTool.Category}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.AccentText}" />
                        </Border>
                        <TextBlock Margin="0,14,0,0"
                                   Text="{Binding SelectedTool.Name}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding SelectedTool.Subtitle}"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Margin="0,18,0,0"
                                   Text="{Binding SelectedTool.Note}"
                                   FontSize="12"
                                   LineHeight="20"
                                   Foreground="{StaticResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" />
                        <Button Margin="0,24,0,0"
                                Content="开始处理"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                Padding="18,7"
                                FontSize="13"
                                Foreground="White"
                                Background="{StaticResource Brush.Accent}"
                                BorderThickness="0" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="工具操作界面将在后续版本中提供。"
                                   FontSize="11"
                                   Foreground="{StaticResource Brush.TextTertiary}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="AIPDF for Windows · v0.1.0"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextTertiary}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
