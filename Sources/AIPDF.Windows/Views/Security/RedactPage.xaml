<UserControl x:Class="AIPDF.Windows.Views.Security.RedactPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SecurityPageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Margin="36,28,36,28">
            <!-- 页头 -->
            <TextBlock Text="{Binding Tool.Name}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Tool.Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Tool.Note}" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />

            <!-- 错误横幅 -->
            <Border Style="{StaticResource ErrorBannerBorder}"
                    Margin="0,18,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" />
            </Border>

            <!-- 文件 -->
            <TextBlock Text="文件" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
            <Border Style="{StaticResource DropZoneBorder}"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    DragOver="DropZone_DragOver">
                <StackPanel>
                    <TextBlock Text="拖入 PDF 文件，或点击下方按钮添加。" Style="{StaticResource FieldHint}" />
                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="移除" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="添加文件…" Style="{StaticResource SecondaryButton}" Click="AddFiles_Click" />
                <Button Content="清空" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ClearFilesCommand}" />
            </StackPanel>

            <!-- 页面范围 -->
            <TextBlock Text="页面范围" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
            <TextBox Style="{StaticResource FieldTextBox}"
                     Width="280"
                     HorizontalAlignment="Left"
                     Text="{Binding Pages, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="留空为全部；例如 1-3,5。"
                       Style="{StaticResource FieldHint}"
                       Margin="0,6,0,0" />

            <!-- 遮盖内容 -->
            <TextBlock Text="匹配文字（每行一项，可选）" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
            <TextBox Style="{StaticResource FieldTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="84"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="按关键词删除页面上的相关内容；留空时按下方区域遮盖。没有匹配到任何文字时不会生成输出。"
                       Style="{StaticResource FieldHint}"
                       Margin="0,6,0,0" />

            <!-- 位置与尺寸 -->
            <TextBlock Text="区域遮盖（点）" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="左边缘 X" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldTextBox}" Width="90" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="上边缘 Y" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldTextBox}" Width="90" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="宽度" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldTextBox}" Width="90" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="高度" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldTextBox}" Width="90" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
            <TextBlock Text="从页面左上角起算，1 点 = 1/72 英寸。遮盖会真正移除内容并清理元数据、附件、批注和表单；导出后请复核结果。"
                       Style="{StaticResource FieldHint}"
                       Margin="0,6,0,0" />

            <!-- 输出 -->
            <TextBlock Text="输出文件夹" Style="{StaticResource SectionTitle}" Margin="0,24,0,0" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource FieldTextBox}" Text="{Binding OutputDir, Mode=OneWay}" IsReadOnly="True" />
                <Button Grid.Column="1" Content="选择…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseOutput_Click" />
            </Grid>
            <TextBlock Text="每次处理都会在输出文件夹里新建任务子目录，不覆盖源文件。"
                       Style="{StaticResource FieldHint}"
                       Margin="0,6,0,0" />

            <!-- 执行 -->
            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <Button Content="开始处理" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" />
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding CancelCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />
            <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay}"
                         Maximum="1"
                         Height="4"
                         Margin="0,10,0,0" />
            <TextBlock Text="{Binding ProgressMessage}" Style="{StaticResource FieldHint}" Margin="0,4,0,0" />

            <!-- 结果 -->
            <ItemsControl ItemsSource="{Binding Results}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2"
                                   Text="{Binding Name, StringFormat=已生成：{0}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   ToolTip="{Binding Path}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
