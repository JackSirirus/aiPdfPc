<UserControl x:Class="AIPDF.Windows.Views.PageOrganizer.OrganizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:AIPDF.Windows.Views.PageOrganizer">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AIPDF.Windows;component/Views/PageOrganizer/PageOrganizerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 排列页面：pages 顺序敏感、允许重复；一次只处理一份 -->
    <shell:ToolPageShell>
        <shell:ToolPageShell.OptionsContent>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelText}" Text="页面顺序" />
                <TextBox Style="{StaticResource FormTextBox}"
                         Margin="0,6,0,0"
                         Text="{Binding PagesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0"
                           Text="按输入顺序排列页面，允许重复；留空保持原顺序，例如 3,1,2。" />
            </StackPanel>
        </shell:ToolPageShell.OptionsContent>
    </shell:ToolPageShell>
</UserControl>
