<UserControl x:Class="AIPDF.Windows.Views.PageOrganizer.SplitPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:AIPDF.Windows.Views.PageOrganizer">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AIPDF.Windows;component/Views/PageOrganizer/PageOrganizerResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 拆分 PDF：按范围拆分，或一页一份 -->
    <shell:ToolPageShell>
        <shell:ToolPageShell.OptionsContent>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabelText}" Text="拆分范围" />
                <TextBox Style="{StaticResource FormTextBox}"
                         Margin="0,6,0,0"
                         Text="{Binding RangesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource HelpText}" Margin="0,6,0,0"
                           Text="留空逐页拆分；用分号分组，例如 1-3;4-6;7" />
            </StackPanel>
        </shell:ToolPageShell.OptionsContent>
    </shell:ToolPageShell>
</UserControl>
