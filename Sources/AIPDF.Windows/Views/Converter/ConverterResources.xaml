<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        转换组（格式转换）工具页本地样式。
        通用 token（画刷、PageTitle/FieldLabel/FieldTextBox/PrimaryButton 等）一律取自 App.xaml
        应用级资源；ConverterWarnBackground/ConverterWarnText 亦已在 V3 T10 上收至 App.xaml（亮/暗两套），
        本文件只放转换组特有的卡片 / 警示横幅样式，不定义任何 Brush.* 色值。
    -->

    <!-- 内容卡片：白底 + 细边框 + 8px 圆角（与侧栏条目 6px、空态图标 18px 同一圆角阶梯） -->
    <Style x:Key="ConverterCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ConverterWarnBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.ConverterWarnBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <!-- DependencyWarning 为 null（依赖可用）时整条横幅隐藏 -->
            <DataTrigger Binding="{Binding DependencyWarning}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConverterWarnText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.ConverterWarnText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- 页面纵向排布：上标题、横幅、文件、参数、执行栏 -->
    <Style x:Key="ConverterPageStack" TargetType="StackPanel">
        <Setter Property="Margin" Value="32,24,32,24" />
    </Style>

    <!-- 文件行移除按钮：轻量 ✕ -->
    <Style x:Key="ConverterRemoveButton" TargetType="Button">
        <Setter Property="Content" Value="✕" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 执行按钮：主色圆角（PrimaryButton 的圆角模板化版本，仅本组使用） -->
    <Style x:Key="ConverterPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
