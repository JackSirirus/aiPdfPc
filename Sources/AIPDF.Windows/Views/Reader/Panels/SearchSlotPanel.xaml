<UserControl x:Class="AIPDF.Windows.Views.Reader.Panels.SearchSlotPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 搜索面板槽位（T4 占位）：T8 填充真实搜索 UI（Ctrl+F + 页内高亮，PRD 3.3 FR-09/10） -->
    <Border Background="{StaticResource Brush.Sidebar}"
            CornerRadius="8"
            Padding="16,14"
            VerticalAlignment="Top"
            Margin="0,8">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE721;"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Accent}" />
                <TextBlock Text="全文搜索"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>
            <TextBlock Margin="0,4,0,0"
                       Text="搜索面板将在后续版本提供（Ctrl+F 触发）。"
                       FontSize="11"
                       LineHeight="16"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextTertiary}" />
        </StackPanel>
    </Border>
</UserControl>
