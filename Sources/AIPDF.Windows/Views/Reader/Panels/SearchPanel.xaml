<UserControl x:Class="AIPDF.Windows.Views.Reader.Panels.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- T8 全文搜索面板（左栏第四面板）：搜索框（防抖）→ 命中列表（页码 + 摘录 + 质量低徽标）；
         无文本层 → 置灰 + 去 OCR；索引中/部分索引过渡态。视觉沿用 App.xaml 应用级设计 token。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SearchCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 命中条目：行点击跳转 + 页内高亮（代码后置 SelectionChanged） -->
        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding PageLabel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SearchResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="0,1,8,0"
                        Padding="6,2"
                        CornerRadius="4"
                        Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock Text="{Binding PageLabel}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.AccentText}" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Excerpt}"
                               FontSize="12"
                               LineHeight="17"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <!-- 低质量页命中标注【D12】 -->
                    <Border Margin="0,3,0,0"
                            Padding="5,1"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Sidebar}"
                            BorderBrush="{DynamicResource Brush.Error}"
                            BorderThickness="1"
                            Visibility="{Binding IsLowQualityPage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="提取质量低"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Error}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索框 + 关闭（✕ 退出搜索并恢复原面板，Esc 等效） -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SearchCloseButton}"
                    Click="OnCloseClick"
                    ToolTip="退出搜索并返回原面板"
                    AutomationProperties.Name="退出搜索">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="10" />
            </Button>
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource FieldTextBox}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsTextLayerAvailable}"
                     ToolTip="输入关键词即时搜索（中文/英文）"
                     AutomationProperties.Name="搜索关键词" />
        </DockPanel>

        <!-- 过渡态：索引中【ST-16】/ 部分索引 / 错误 -->
        <StackPanel Grid.Row="1" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding IsIndexing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE895;"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="索引中…"
                           FontSize="11"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
            <TextBlock Text="{Binding StatusHint}"
                       Margin="0,3,0,0"
                       FontSize="11"
                       LineHeight="16"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       Visibility="{Binding HasStatusHint, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 结果摘要 + 搜索范围（V4 T14：当前文档 / 所有打开的文档） -->
        <DockPanel Grid.Row="2" Margin="0,6,0,4">
            <ComboBox x:Name="ScopeBox"
                      DockPanel.Dock="Right"
                      Width="104"
                      Height="22"
                      Margin="6,0,0,0"
                      FontSize="11"
                      VerticalContentAlignment="Center"
                      SelectedIndex="0"
                      SelectionChanged="OnScopeChanged"
                      ToolTip="搜索范围：当前文档 / 所有打开的文档">
                <ComboBoxItem Content="当前文档" />
                <ComboBoxItem Content="所有打开文档" />
            </ComboBox>
            <TextBlock Text="{Binding ResultSummary}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <!-- 命中列表（单文档：扁平列表） -->
        <ListBox x:Name="ResultList"
                 Grid.Row="3"
                 ItemsSource="{Binding Results}"
                 ItemTemplate="{StaticResource SearchResultTemplate}"
                 ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,0,2,8"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnResultSelected"
                 Visibility="{Binding IsSingleDocument, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="搜索结果列表" />

        <!-- 跨文档命中（V4 T14：按文档分组，组头显示文件名与命中数） -->
        <ScrollViewer Grid.Row="3"
                      Padding="0,0,2,8"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsCrossDocument, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Header}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,0,0,3"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="OnGroupedResultClick">
                                            <ContentPresenter Content="{Binding}"
                                                              ContentTemplate="{StaticResource SearchResultTemplate}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 搜索后无命中空态（文本层可用时） -->
        <Border Grid.Row="1" Grid.RowSpan="3"
                Background="{DynamicResource Brush.Sidebar}"
                CornerRadius="8"
                Padding="16,14"
                VerticalAlignment="Top"
                Margin="0,8"
                Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="未找到匹配内容"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Margin="0,4,0,0"
                           Text="换个关键词或检查是否存在错别字。"
                           FontSize="11"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
            </StackPanel>
        </Border>

        <!-- 无文本层降级【ST-15】：搜索框已置灰 + 去 OCR 引导（复用 T7 工具通道） -->
        <Border Grid.Row="1" Grid.RowSpan="3"
                Background="{DynamicResource Brush.Sidebar}"
                CornerRadius="8"
                Padding="16,14"
                VerticalAlignment="Top"
                Margin="0,8"
                Visibility="{Binding ShowNoTextLayer, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="该文档没有可搜索的文本层"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Margin="0,4,0,0"
                           Text="这是扫描件或图片型 PDF。可先执行 OCR 识别文字，再回来搜索。"
                           FontSize="11"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
                <Button Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding GoToOcrCommand}"
                        AutomationProperties.Name="去 OCR">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8B4;"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="去 OCR"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
