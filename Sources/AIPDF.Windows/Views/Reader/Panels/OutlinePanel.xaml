<UserControl x:Class="AIPDF.Windows.Views.Reader.Panels.OutlinePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels">
    <!-- 目录面板（T4）：只读书签树 + 点击跳页；无大纲空态【ST-17】 -->
    <UserControl.Resources>
        <!-- 树展开箭头：细线折角，随主题 Foreground 走（不用图标字体） -->
        <Style x:Key="OutlineExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Grid>
                                <!-- 折叠：右向折角 -->
                                <Path x:Name="ArrowCollapsed"
                                      Data="M 1 1 L 5 5 L 1 9"
                                      Stroke="{DynamicResource Brush.TextTertiary}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <!-- 展开：下向折角 -->
                                <Path x:Name="ArrowExpanded"
                                      Data="M 1 1 L 5 5 L 9 1"
                                      Stroke="{DynamicResource Brush.TextTertiary}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ArrowCollapsed" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ArrowExpanded" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A+C Phase 2：选中目录项 = AccentSoft 底 + AccentText 文字（对齐 SearchPanel）。
             自绘 TreeViewItem 模板以覆盖系统默认选中高亮；标题 TextBlock 不设 Foreground，
             继承本样式的 Foreground（默认 TextPrimary / 选中 AccentText），
             CanNavigate=False 的本地样式触发器仍优先。 -->
        <Style x:Key="OutlineItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="4,2"
                                    Margin="0,1"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource OutlineExpanderToggle}" />
                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <TreeView x:Name="OutlineTree"
                  ItemsSource="{Binding Items}"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource OutlineItemStyle}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectedItemChanged="OnOutlineSelected">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Border ToolTip="点击跳转到该页">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 不设 Foreground：继承 TreeViewItem（默认 TextPrimary / 选中 AccentText） -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontSize="12"
                                       Padding="0,3"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanNavigate}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PageLabel}"
                                       FontSize="10"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextTertiary}" />
                        </Grid>
                    </Border>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 空态【ST-17】：无大纲 → 引导替代路径 -->
        <Border Background="{DynamicResource Brush.Sidebar}"
                CornerRadius="8"
                Padding="16,14"
                VerticalAlignment="Top"
                Margin="0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasOutline}" Value="False" />
                                <Condition Binding="{Binding IsLoading}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="此文档没有目录"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Margin="0,4,0,0"
                           Text="可用缩略图浏览，或为常看页面添加书签。"
                           FontSize="11"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
            </StackPanel>
        </Border>

        <!-- 读取失败提示 -->
        <Border Background="{DynamicResource Brush.Sidebar}"
                CornerRadius="8"
                Padding="12,8"
                VerticalAlignment="Top"
                Margin="0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
    </Grid>
</UserControl>
