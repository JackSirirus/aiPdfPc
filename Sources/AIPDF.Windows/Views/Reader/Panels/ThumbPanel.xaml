<UserControl x:Class="AIPDF.Windows.Views.Reader.Panels.ThumbPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels">
    <!-- 缩略图面板（T4）：虚拟化 ListBox + 渐进渲染；点击跳页（跳页事件 → 宿主 ReaderView 接线挂点） -->
    <Grid>
        <ListBox x:Name="ThumbsList"
                 ItemsSource="{Binding Items}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0,2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="OnThumbSelected">
            <!-- A+C Phase 2：选中缩略图 = 2px 强调描边（复用 Brush.Accent，不新增 token）。
                 容器自绘外框，避免系统默认高亮；内层条目边框保持 1px 暖边框。 -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="SelectionOutline"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SelectionOutline"
                                                Property="BorderBrush"
                                                Value="{DynamicResource Brush.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2,4"
                            CornerRadius="6"
                            Background="{DynamicResource Brush.Window}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            ToolTip="点击跳转到该页">
                        <Grid Width="{x:Static vm:ThumbPanelViewModel.ThumbWidth}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 位图未就绪时显示占位框（渐进渲染填充） -->
                            <Border Grid.Row="0"
                                    Height="{Binding Height}"
                                    Background="{DynamicResource Brush.Sidebar}"
                                    CornerRadius="4,4,0,0">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Label}"
                                       FontSize="10"
                                       Padding="0,3"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
