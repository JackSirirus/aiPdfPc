<UserControl x:Class="AIPDF.Windows.Views.Reader.Panels.BookmarkPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 书签条目：行点击跳转（代码后置），悬停出删除 -->
        <Style x:Key="BookmarkItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE735;"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Accent}" />
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding DataContext.RemoveBookmarkCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="删除书签"
                                        AutomationProperties.Name="删除书签"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4,2">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE711;"
                                                           FontSize="9"
                                                           Foreground="{StaticResource Brush.TextTertiary}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 收藏当前页（当前页由宿主推送：SetCurrentPage；ReaderView 接线挂点 T7） -->
        <Button Grid.Row="0"
                Margin="0,2,0,6"
                Padding="10,6"
                HorizontalContentAlignment="Center"
                Command="{Binding AddCurrentPageCommand}"
                Background="{StaticResource Brush.AccentSoft}"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="把当前正在阅读的页加入书签">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="&#xE735;"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.AccentText}" />
                <TextBlock Text="收藏当前页"
                           FontSize="12"
                           Margin="6,0,0,0"
                           Foreground="{StaticResource Brush.AccentText}" />
            </StackPanel>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanAddBookmark}" Value="False">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <ListBox Grid.Row="1"
                 x:Name="BookmarkList"
                 ItemsSource="{Binding Items}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 VirtualizingPanel.IsVirtualizing="True"
                 ItemContainerStyle="{StaticResource BookmarkItemStyle}"
                 SelectionChanged="OnBookmarkSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <!-- 空态【ST-18】：尚无书签 -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Sidebar}"
                CornerRadius="8"
                Padding="16,14"
                VerticalAlignment="Top"
                Margin="0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBookmarks}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="尚无书签"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}" />
                <TextBlock Margin="0,4,0,0"
                           Text="点「收藏当前页」记录常看位置；书签在本次会话内有效。"
                           FontSize="11"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextTertiary}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
