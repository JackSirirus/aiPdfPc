<!-- T9 加密文档密码解锁（【ST-04】）：模态密码框；错误行内红字、不清空输入、不限次数；
     取消 / Esc 不产生标签；密码只经回调尝试解锁，从不绑定到控件之外的任何状态，不落盘、不写日志。 -->
<Window x:Class="AIPDF.Windows.Views.Reader.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:reader="clr-namespace:AIPDF.Windows.Views.Reader"
        Title="{x:Static reader:ReaderStrings.PasswordDialogTitle}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{x:Static reader:ReaderStrings.PasswordDialogHint}"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="FileNameText"
                   Margin="0,6,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextTrimming="CharacterEllipsis" />

        <!-- PasswordBox 明文不暴露给任何绑定；仅在点击「解锁」时读取一次传给尝试回调 -->
        <PasswordBox x:Name="PasswordInput"
                     Margin="0,12,0,0"
                     Height="32"
                     FontSize="13"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Brush.FieldBackground}"
                     BorderBrush="{DynamicResource Brush.Border}" />

        <!-- 行内红字错误：错误后不清空输入框，允许无限次重试；取消/Esc 关闭不产生标签 -->
        <TextBlock x:Name="ErrorText"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource Brush.Error}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{x:Static reader:ReaderStrings.PasswordDialogUnlock}"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    MinWidth="88"
                    Click="OnUnlockClick" />
            <Button Content="{x:Static reader:ReaderStrings.Cancel}"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
