<!-- T3 虚拟化连续阅读视图：VirtualizingStackPanel 承载惰性页容器（可见页 ± 缓冲页渲染，其余骨架占位）
     + 状态栏（页码跳转 / 九档缩放阶梯 / 适配宽度·页面）。
     布局与视觉沿用 App.xaml 应用级设计 token（色板 / 字号阶梯 / 4 的倍数间距网格）。 -->
<UserControl x:Class="AIPDF.Windows.Views.Reader.ReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reader="clr-namespace:AIPDF.Windows.Views.Reader"
             xmlns:vm="clr-namespace:AIPDF.Windows.ViewModels"
             MinWidth="480"
             MinHeight="240"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 缩放 ＋/− 小方钮：基于全局 SecondaryButton 收紧内距 -->
        <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 适配档按钮：激活时高亮（手动缩放后脱离，FR-06/ST-11） -->
        <Style x:Key="FitWidthButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.FitWidthToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFitWidthActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FitPageButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.FitPageToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFitPageActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 页码输入框：非法输入红边（FR-05），抖动动画在 code-behind -->
        <Style x:Key="JumpBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.JumpBoxToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsJumpInvalid}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 阅读区 ============ -->
        <Grid Grid.Row="0">

            <!-- 空态（无文档） -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static reader:ReaderStrings.EmptyStateTitle}"
                           Style="{StaticResource SectionTitle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static reader:ReaderStrings.EmptyStateHint}"
                           Style="{StaticResource FieldHint}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- 虚拟化滚动承载：ScrollViewer(CanContentScroll) → ItemsControl → VirtualizingStackPanel。
                 ScrollUnit=Pixel 保证平滑滚动；CacheLength=0,0 关闭面板级额外实现，
                 渲染缓冲完全由 ViewModel 的可视页 ± 缓冲计算驱动（纯逻辑，可测）。 -->
            <ScrollViewer x:Name="ScrollHost"
                          CanContentScroll="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource Brush.Sidebar}"
                          PreviewMouseWheel="OnPreviewMouseWheel"
                          ScrollChanged="OnScrollChanged">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Pages}"
                              HorizontalContentAlignment="Center"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLength="0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReaderPageItemViewModel}">
                            <!-- 惰性页容器：宽高始终绑定页尺寸缓存换算值（骨架保持正确宽高比，避免跳动【ST-10】）；
                                 底部 16px 即 FR-01 页间距，与 PageLayoutCalculator.PageGap 一致 -->
                            <Grid Width="{Binding DisplayWidth}"
                                  Height="{Binding DisplayHeight}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,0,0,16">
                                <!-- 骨架占位：快速滚动未渲染页状态 -->
                                <Border Background="{StaticResource Brush.Hover}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRendered}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number, StringFormat=第 {0} 页}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                        <TextBlock Text="{x:Static reader:ReaderStrings.RenderingHint}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Brush.TextTertiary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRendering}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <!-- 渲染位图：T1 后台线程产出（冻结），Stretch=Fill 精确填充 DIP 容器 -->
                                <Image Source="{Binding Bitmap}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding IsRendered, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ============ 错误条（ST-06 加载失败 / 渲染失败汇总） ============ -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.FieldBackground}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       TextWrapping="Wrap" />
        </Border>

        <!-- ============ 状态栏：页码跳转（FR-05）+ 缩放控制（FR-06） ============ -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Window}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- 左：当前页/总页数 + 页码跳转输入框 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static reader:ReaderStrings.PagePrefix}"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="JumpBox"
                             Style="{StaticResource JumpBoxStyle}"
                             Text="{Binding JumpText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnJumpBoxKeyDown" />
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="2,0,0,0">
                        <Run Text="页 / 共 " />
                        <Run Text="{Binding PageCount, Mode=OneWay}" />
                        <Run Text=" 页" />
                    </TextBlock>
                    <TextBlock Text="{x:Static reader:ReaderStrings.JumpInvalid}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJumpInvalid}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 右：− / 缩放值 / ＋ / 适配宽度 / 适配页面 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ZoomButton}"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip="{x:Static reader:ReaderStrings.ZoomOutToolTip}"
                            Content="−" />
                    <TextBlock Text="{Binding ZoomDisplayText}"
                               Style="{StaticResource FieldLabel}"
                               Width="52"
                               TextAlignment="Center" />
                    <Button Style="{StaticResource ZoomButton}"
                            Command="{Binding ZoomInCommand}"
                            ToolTip="{x:Static reader:ReaderStrings.ZoomInToolTip}"
                            Content="＋" />
                    <Button Style="{StaticResource FitWidthButton}"
                            Command="{Binding FitWidthCommand}"
                            Content="{x:Static reader:ReaderStrings.FitWidthLabel}" />
                    <Button Style="{StaticResource FitPageButton}"
                            Command="{Binding FitPageCommand}"
                            Content="{x:Static reader:ReaderStrings.FitPageLabel}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
