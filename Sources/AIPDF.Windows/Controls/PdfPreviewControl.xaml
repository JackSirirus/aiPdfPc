<UserControl x:Class="AIPDF.Windows.Controls.PdfPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle">

    <UserControl.Resources>
        <!-- 色板与 MainWindow 一致；预览底色与框选橙取自上游 PDFPreview.swift -->
        <SolidColorBrush x:Key="Brush.PreviewBg" Color="#EDEFF2" />
        <SolidColorBrush x:Key="Brush.Toolbar" Color="#F6F6F8" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E4E4E9" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#3159D9" />
        <SolidColorBrush x:Key="Brush.SelectionStroke" Color="#FF9500" />
        <SolidColorBrush x:Key="Brush.SelectionFill" Color="#24FF9500" />
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.PreviewBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页面区域：位图 + 框选 overlay（同一 Grid 单元，canvas 与页面位图重合，
                 因此鼠标坐标即页面相对 view 坐标，无需再叠加滚动偏移） -->
            <ScrollViewer x:Name="PageScroller"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <Grid Margin="24"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Image x:Name="PageImage"
                           Stretch="None"
                           SnapsToDevicePixels="True"
                           Visibility="Collapsed" />
                    <Canvas x:Name="SelectionCanvas"
                            Background="Transparent"
                            ClipToBounds="True"
                            Visibility="Collapsed"
                            MouseLeftButtonDown="OnSelectionMouseDown"
                            MouseMove="OnSelectionMouseMove"
                            MouseLeftButtonUp="OnSelectionMouseUp"
                            LostMouseCapture="OnSelectionLostCapture">
                        <Rectangle x:Name="SelectionRect"
                                   Visibility="Collapsed"
                                   Stroke="{StaticResource Brush.SelectionStroke}"
                                   Fill="{StaticResource Brush.SelectionFill}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="5 3"
                                   StrokeDashCap="Flat" />
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- 空态 -->
            <Border x:Name="EmptyState"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Background="#FFFFFF"
                    Padding="28,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" />
                </Border.Effect>
                <StackPanel TextBlock.TextAlignment="Center">
                    <TextBlock Text="尚无预览"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="打开 PDF 文件后在此预览。"
                               FontSize="12"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="Ctrl+滚轮 缩放 · PageUp / PageDown 翻页"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextTertiary}" />
                </StackPanel>
            </Border>

            <!-- 底部工具栏：翻页 + 页码 + 缩放显示 -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Toolbar}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="14,5">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevPageButton"
                                Content="‹ 上一页"
                                Click="OnPrevPageClick"
                                Padding="12,4"
                                FontSize="12"
                                Foreground="{StaticResource Brush.TextPrimary}"
                                IsEnabled="False" />
                        <TextBlock x:Name="PageIndicator"
                                   Text="– / –"
                                   MinWidth="72"
                                   Margin="10,0"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <Button x:Name="NextPageButton"
                                Content="下一页 ›"
                                Click="OnNextPageClick"
                                Padding="12,4"
                                FontSize="12"
                                Foreground="{StaticResource Brush.TextPrimary}"
                                IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="ZoomIndicator"
                               Text="–"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource Brush.TextTertiary}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
