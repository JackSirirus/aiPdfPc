<Application x:Class="AIPDF.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reader="clr-namespace:AIPDF.Windows.Views.Reader">
    <Application.Resources>

        <!-- 应用级设计 token（V3 T10 / C2 夜间模式）：
             - 下面是「亮色」默认 token 集，键名 `Brush.*` 语义不变（全仓引用）；
             - 紧随其后是 `Brush.Dark.*` 暗色对应项（每项一一对应，禁止只加亮不加暗）；
             - 运行时由 Services/ThemeManager 把选定 token 集写入 Application.Resources
               （亮/暗/跟随系统），因此所有主题引用必须是 DynamicResource——
               替换已解析的 StaticResource 不会更新界面。
             - 工具页是独立 UserControl，共享 token 放在应用级；本文件是色值唯一来源，
               各工具页/资源字典不得再复制 Brush.* 定义（含暗色）。
             - 批注/内容色（高亮色板、框选叠层等）是文档内容色，不是主题色，仍留在使用处。 -->
        <SolidColorBrush x:Key="Brush.Window" Color="#FBFAF7" />
        <SolidColorBrush x:Key="Brush.Sidebar" Color="#F4F1EA" />
        <SolidColorBrush x:Key="Brush.Hover" Color="#ECE7DD" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E4DDCF" />
        <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C9C0AE" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#2A251E" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6659" />
        <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9C9384" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#3159D9" />
        <SolidColorBrush x:Key="Brush.AccentHover" Color="#2749AE" />
        <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1F3B8F" />
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E7EBF8" />
        <SolidColorBrush x:Key="Brush.AccentText" Color="#2A4CBB" />
        <SolidColorBrush x:Key="Brush.Error" Color="#C4321F" />
        <SolidColorBrush x:Key="Brush.FieldBackground" Color="#FFFDF8" />
        <SolidColorBrush x:Key="Brush.Surface" Color="#F7F4EC" />
        <!-- 搜索命中高亮（T8）：半透明琥珀填充 + 较深边框；叠加在渲染页上，跟随主题切换但保持可辨 -->
        <SolidColorBrush x:Key="Brush.SearchHighlight" Color="#66FFD84D" />
        <SolidColorBrush x:Key="Brush.SearchHighlightBorder" Color="#CCFFB300" />
        <!-- 状态语义色（流程/批量状态胶囊） -->
        <SolidColorBrush x:Key="Brush.Success" Color="#1F7A3D" />
        <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E4F3E9" />
        <SolidColorBrush x:Key="Brush.Danger" Color="#B3382E" />
        <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBEAE8" />
        <SolidColorBrush x:Key="Brush.NeutralSoft" Color="#EFEAE0" />
        <!-- 依赖缺失警示横幅（Converter 组） -->
        <SolidColorBrush x:Key="Brush.ConverterWarnBackground" Color="#FBF2DF" />
        <SolidColorBrush x:Key="Brush.ConverterWarnText" Color="#8A5300" />
        <!-- 预览控件底色 / 底部工具栏（PdfPreviewControl，原本地调色板已上收） -->
        <SolidColorBrush x:Key="Brush.PreviewBg" Color="#ECE7DC" />
        <SolidColorBrush x:Key="Brush.Toolbar" Color="#F4F1EA" />
        <!-- 拖拽槽常态 / 悬停底色（PageOrganizer、Security 组） -->
        <SolidColorBrush x:Key="Brush.DropZoneBackground" Color="#FCFAF4" />
        <SolidColorBrush x:Key="Brush.DropZoneHoverBackground" Color="#EEF1FA" />
        <!-- A+C Phase 4：模态/锁定遮罩叠层（暖半透明，替代 WizardDialog 硬编码 scrim 与 LockOverlay 的 Brush.Sidebar） -->
        <SolidColorBrush x:Key="Brush.OverlayMask" Color="#732B251C" />
        <!-- A+C Phase 4：强调色底上的前景文字/描边（主色按钮、当前文档徽标、Toast 等） -->
        <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

        <!-- ============================================================
             暗色 token 集（与上方亮色 token 一一对应）。
             仅由 Services/ThemeManager 读取并写入同名 `Brush.*` 键；
             XAML 不直接引用 `Brush.Dark.*`。选中「亮色」时用 ThemeManager 启动快照还原。
             ============================================================ -->
        <SolidColorBrush x:Key="Brush.Dark.Window" Color="#1C1A17" />
        <SolidColorBrush x:Key="Brush.Dark.Sidebar" Color="#23201A" />
        <SolidColorBrush x:Key="Brush.Dark.Hover" Color="#302C24" />
        <SolidColorBrush x:Key="Brush.Dark.Border" Color="#3A3529" />
        <SolidColorBrush x:Key="Brush.Dark.BorderStrong" Color="#4C4636" />
        <SolidColorBrush x:Key="Brush.Dark.TextPrimary" Color="#EDE7DA" />
        <SolidColorBrush x:Key="Brush.Dark.TextSecondary" Color="#B3AA99" />
        <SolidColorBrush x:Key="Brush.Dark.TextTertiary" Color="#877F6F" />
        <SolidColorBrush x:Key="Brush.Dark.Accent" Color="#7E9CD8" />
        <SolidColorBrush x:Key="Brush.Dark.AccentHover" Color="#90ACDF" />
        <SolidColorBrush x:Key="Brush.Dark.AccentPressed" Color="#6B88C4" />
        <SolidColorBrush x:Key="Brush.Dark.AccentSoft" Color="#272F41" />
        <SolidColorBrush x:Key="Brush.Dark.AccentText" Color="#A9C0EA" />
        <SolidColorBrush x:Key="Brush.Dark.Error" Color="#E88B7D" />
        <SolidColorBrush x:Key="Brush.Dark.FieldBackground" Color="#262219" />
        <SolidColorBrush x:Key="Brush.Dark.Surface" Color="#201D17" />
        <!-- 搜索高亮是叠加在渲染页上的内容标记，亮暗保持一致 -->
        <SolidColorBrush x:Key="Brush.Dark.SearchHighlight" Color="#66FFD84D" />
        <SolidColorBrush x:Key="Brush.Dark.SearchHighlightBorder" Color="#CCFFB300" />
        <SolidColorBrush x:Key="Brush.Dark.Success" Color="#7FC08E" />
        <SolidColorBrush x:Key="Brush.Dark.SuccessSoft" Color="#1F2C22" />
        <SolidColorBrush x:Key="Brush.Dark.Danger" Color="#E88B7D" />
        <SolidColorBrush x:Key="Brush.Dark.DangerSoft" Color="#38231F" />
        <SolidColorBrush x:Key="Brush.Dark.NeutralSoft" Color="#2C2820" />
        <SolidColorBrush x:Key="Brush.Dark.ConverterWarnBackground" Color="#3A2F1C" />
        <SolidColorBrush x:Key="Brush.Dark.ConverterWarnText" Color="#E6B36A" />
        <SolidColorBrush x:Key="Brush.Dark.PreviewBg" Color="#26221C" />
        <SolidColorBrush x:Key="Brush.Dark.Toolbar" Color="#23201A" />
        <SolidColorBrush x:Key="Brush.Dark.DropZoneBackground" Color="#23201A" />
        <SolidColorBrush x:Key="Brush.Dark.DropZoneHoverBackground" Color="#2C3346" />
        <SolidColorBrush x:Key="Brush.Dark.OverlayMask" Color="#8F0A0805" />
        <SolidColorBrush x:Key="Brush.Dark.OnAccent" Color="#FFFFFF" />

        <!-- 衬线展示字体（A+C Phase 1）：只用于展示/标题（PageTitle、SectionTitle、工具页标题、
             hero 标题与模态标题）。正文、表单、按钮、状态栏、图标字形（Segoe MDL2 Assets）保持 sans。
             WPF FontFamily 支持逗号回退链；Windows 原生一般命中 SimSun（宋体）。
             字体不随主题切换，故样式内用 StaticResource 引用（审计只禁止 StaticResource Brush.*）。 -->
        <FontFamily x:Key="FontFamily.Display">Source Han Serif SC, Noto Serif SC, Songti SC, SimSun, Georgia</FontFamily>

        <!-- A+C Phase 2：焦点环 = accent（仅键盘焦点时由 WPF 装饰层绘制，不占布局）。
             AccentFocusVisual：按钮等通用控件 = 2px Brush.Accent 外环；
             InputFocusVisual：输入类 = Brush.Accent 边框 + Brush.AccentSoft 3px 柔环。
             引用的样式资源非 Brush.*，审计允许 StaticResource。 -->
        <Style x:Key="AccentFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="1"
                                   RadiusX="6"
                                   RadiusY="6"
                                   Stroke="{DynamicResource Brush.Accent}"
                                   StrokeThickness="2"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Grid>
                            <Border BorderBrush="{DynamicResource Brush.AccentSoft}"
                                    BorderThickness="3"
                                    CornerRadius="8"
                                    Margin="-3" />
                            <Border BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="-1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字号阶梯：26 页标题 / 15 区块标题 / 13 正文与字段 / 12 辅助 / 11 脚注（与 MainWindow 一致） -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Display}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Display}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 字段输入：统一 padding 与边框；间距走 4 的倍数网格 -->
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.FieldBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <!-- A+C Phase 2：输入聚焦 = Accent 边框 + AccentSoft 3px 焦点环 -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource InputFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldInput}" />
        <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource FieldInput}" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.FieldBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        </Style>
        <!-- A+C 方案 A（底栏合一）：阅读控件样式由 ReaderView 提升到应用级——
             控件已从阅读视图内部底栏移入主窗口状态栏，DataContext 仍是 ReaderViewModel，
             故样式内的 DataTrigger（IsFitWidthActive / IsFitPageActive / SpreadEnabled / IsJumpInvalid）不变。 -->
        <Style x:Key="ZoomButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FitWidthButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.FitWidthToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFitWidthActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FitPageButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.FitPageToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFitPageActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SpreadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.SpreadToggleToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpreadEnabled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="JumpBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{x:Static reader:ReaderStrings.JumpBoxToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsJumpInvalid}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Application.Resources>
</Application>
