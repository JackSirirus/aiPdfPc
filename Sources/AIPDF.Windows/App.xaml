<Application x:Class="AIPDF.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>

        <!-- 应用级设计 token：色板与 MainWindow / PdfPreviewControl 保持一致。
             工具页是独立 UserControl，StaticResource 无法回溯到宿主 Window 的资源，
             因此共享 token 放在应用级；值不得与 MainWindow 漂移。 -->
        <SolidColorBrush x:Key="Brush.Window" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.Sidebar" Color="#F6F6F8" />
        <SolidColorBrush x:Key="Brush.Hover" Color="#EBEBEF" />
        <SolidColorBrush x:Key="Brush.Border" Color="#E4E4E9" />
        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1D1D1F" />
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6E6E73" />
        <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A9AA0" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#3159D9" />
        <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4EAFB" />
        <SolidColorBrush x:Key="Brush.AccentText" Color="#2A4CBB" />
        <SolidColorBrush x:Key="Brush.Error" Color="#C4321F" />
        <SolidColorBrush x:Key="Brush.FieldBackground" Color="#FFFFFF" />
        <!-- 搜索命中高亮（T8）：半透明琥珀填充 + 较深边框，叠加在渲染页上仍清晰可辨且不遮字符 -->
        <SolidColorBrush x:Key="Brush.SearchHighlight" Color="#66FFD84D" />
        <SolidColorBrush x:Key="Brush.SearchHighlightBorder" Color="#CCFFB300" />

        <!-- 字号阶梯：26 页标题 / 15 区块标题 / 13 正文与字段 / 12 辅助 / 11 脚注（与 MainWindow 一致） -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 字段输入：统一 padding 与边框；间距走 4 的倍数网格 -->
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Brush.FieldBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldInput}" />
        <Style x:Key="FieldComboBox" TargetType="ComboBox" BasedOn="{StaticResource FieldInput}" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource Brush.FieldBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Error}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Application.Resources>
</Application>
